; NFX-BO v1 -- 12-bit packed backport of NFX-BO (bouncing-ball delay on
; the blend of the two tracks before), doubling capture length for the
; same DECIM. Rebuilt 2026-11-06 from NFX-BO's own current, certifier-
; audited build (see BRIEF.md / DESIGN.md for the spec, and DESIGN.md
; Sec 14/15 for this rebuild's own history -- a first attempt at this
; backport was shelved for being far over the real MDS 1.1 cycle
; ceiling; this is a fresh backport, not a resurrection of that file).
;
; Parameter block (Y, relative to r6):
;   Y+1 NBAL   unipolar_q23   neighbour blend: 0=two back(far) 1=one back(near)
;   Y+2 GATE   bipolar_q23    capture-window shaping, 0=full window
;   Y+3 RATE   unipolar_square_q23  initial inter-repeat gap
;   Y+4 BEND   bipolar_q23    per-repeat gap multiplier, 0=steady
;   Y+5 DCAY   unipolar_q23   per-repeat level survival, scaled to a 0.99 ceiling
;   Y+6 MIX    unipolar_q23   dry/wet
;   Y+7 RVRS   bipolar_q23    reverse-capture probability (2026-11-03,
;                             replaces the short-lived live DECM knob --
;                             see below). -max=ALWAYS reverse this trig's
;                             capture, +max=NEVER reverse, 0=50/50; every
;                             value between is the probability of
;                             reversing. Decided once per trig from a
;                             24-bit LCG (RNG_STATE, Y+28) against
;                             p_reverse=(1-RVRS)/2.
;
; DECIM (capture/playback decimation) was BRIEFLY a live 7th knob
; (2026-11-03) but had a real bug: the interpolation ramp's divide-by-
; DECIM shift never actually got switched from its old hardcoded
; immediate to the register-sourced form the derivation implied -- so
; any DECIM above 8 made the ramp overshoot its target every sample and
; never settle (a runaway staircase, "portal to hell" on knob values
; above ~64). Rather than fix-and-reverify the live knob, DECIM is back
; to being a plain compile-time .equ (below) -- edit it in source and
; rebuild for longer/lower-fi captures; there's no live knob for it
; anymore. This frees the slot RVRS now occupies.
;
; TONE (a capture-time highpass, built for an earlier/separate hardware
; report of low-frequency screech) and ALFC (a capture-time lowpass,
; built to fight decimation aliasing) were REMOVED 2026-11-03, freeing
; this file's 7th and 8th (last) parameter slots. ALFC's whole premise
; turned out to be unfixable by filtering: a kick's pitch-envelope sweep
; crosses the decimation Nyquist on every hit, and no FIXED filter
; cutoff can suppress a sweep at the instant it's crossing, confirmed
; directly via spectrogram (ghost copies of the kick's own sweep shape,
; tracking it) before this change. DECIM itself -- raising the Nyquist
; directly -- is the real fix. TONE still worked correctly for its own
; original problem but wasn't needed for this one, and the user chose to
; trade it for budget/slot headroom rather than keep it. Y+8 (ALFC's old
; slot) is left genuinely unused, not repurposed for anything yet.
;
; CAPTURE now also layers in whatever bounce repeats are still ringing
; from a PREVIOUS trig (2026-11-03): instead of storing the raw dry NBAL
; blend alone, CAP_STORE sums dry + the currently-ramping HELD_WET and
; clamps back into range (see CAP_STORE below). When nothing is ringing
; this is a no-op (HELD_WET~=0); when a new trig lands on top of a still-
; audible train, the new capture builds on it instead of starting clean.
;
; Persistent state (Y, relative to r6; all free words past the 6 params):
;   Y+9  TRACKMEM_BASE   this track's TRACK_BUFFERS base word address
;   Y+10 PHASE           0=IDLE 1=ACTIVE (a trig has fired and the train
;                        hasn't fully decayed yet). Capture and bounce
;                        are NOT separate phases of each other -- both
;                        run concurrently once ACTIVE, each gated only
;                        by its own state (CAP_WINDOW_REMAIN for capture,
;                        GAP_REMAIN for bounce). User's explicit
;                        correction: RATE's gap must count from the
;                        moment of the trig itself, not from whenever
;                        capture happens to finish, and capture must
;                        never be cut short by it either -- the two run
;                        on independent clocks. (Capture's write-head
;                        and bounce's read-head advance at the identical
;                        per-sample rate once bounce starts, so the
;                        write-head -- already ahead by however many
;                        samples elapsed before bounce began -- stays
;                        ahead for the rest of the window; bounce can
;                        never read past what's actually been captured.)
;   Y+11 TRIG_FLAG       set by TRIG, consumed once by RENDER
;   Y+12 CAP_POS         capture write offset, 0..CAP_LEN_FINAL-1, in
;                        LOGICAL units (12-bit packing -- word-index =
;                        CAP_POS>>1, sub-phase = CAP_POS&1; see
;                        CAP_STORE below)
;   Y+13 CAP_REMAIN      decimated LOGICAL samples still to capture
;                        (countdown)
;   Y+14 CAP_DECIM_CTR   real-sample countdown between stored capture
;                        samples
;   Y+15 CAP_DELAY_REMAIN real samples to wait before capture starts (GATE>0)
;   Y+16 CAP_LEN_FINAL   final captured length in LOGICAL samples (set
;                        when capture ends)
;   Y+17 BOUNCE_POS      current read/write offset into the captured
;                        buffer, in LOGICAL units (same addressing as
;                        CAP_POS above)
;   Y+18 BOUNCE_DECIM_CTR real-sample countdown for decimated-hold playback
;   Y+19 GAP_REMAIN      real samples until the next repeat restarts
;   Y+20 GAP_CUR         current inter-repeat gap, in real samples
;   Y+21 SAMPLES_REMAINING real samples left in the actively-streaming repeat
;   Y+22 DCAY_MULT       this block's DCAY parameter scaled to its 0.99 ceiling
;   Y+23 ACCUM_LEVEL     running compounded level estimate, resets to ~1.0 per trig
;   Y+24 REPEATS_FIRED   safety counter against MAXREPEATS
;   Y+25 HELD_WET        continuously-ramping interpolated wet output,
;                        nudged by INTERP_STEP every sample
;   Y+26 INTERP_STEP     per-sample increment ramping HELD_WET toward the
;                        latest target over DECIM samples -- smooths both
;                        ordinary decimation steps and pass-restart jumps
;   Y+27 REVERSE_FLAG    this trig's reverse-capture decision (0=forward,
;                        1=reverse), drawn once per trig from RNG_STATE
;                        against RVRS's derived probability and latched
;                        for the trig's whole capture. Replaces the
;                        short-lived DECIM_CUR word (the live DECM knob
;                        was dropped 2026-11-03 -- see the RVRS/DECIM
;                        header comments above), which itself had
;                        replaced the original ANTIALIAS_LPF filter state.
;   Y+28 RNG_STATE       24-bit LCG state driving REVERSE_FLAG's draw.
;                        Advanced once per trig, NEVER reset (including
;                        across IDLE stretches) so consecutive trigs don't
;                        repeat the same draw. Replaces the short-lived
;                        DECIM_M1_CUR word, which itself had replaced the
;                        original ANTIALIAS_LPF2 filter state.
;   Y+29 CAP_WINDOW_REMAIN real samples left in the fixed capture window,
;                        counted DOWN from WINDOW_SAMPLES (the .equ) every
;                        sample regardless of GATE (a countdown is one
;                        instruction cheaper per sample than counting up
;                        and comparing against a constant). Once this
;                        reaches zero, capture simply stops storing for
;                        the rest of the trig -- it does NOT touch PHASE
;                        or bounce in any way (the two run independently,
;                        see Y+10 above). GATE only ever changes WHAT
;                        gets captured (via CAP_REMAIN, the word count
;                        left to store), never WHEN anything happens --
;                        this word's own countdown is itself independent
;                        of GATE too, always running the full fixed
;                        duration regardless.
;   Y+30 PREV_WET_SNAPSHOT a one-time copy of HELD_WET taken at the
;                        instant a fresh trig lands (before HELD_WET
;                        itself gets zeroed for BOUNCE's own output
;                        correctness -- see the RATE/trig-reset block),
;                        so CAP_STORE can still layer "whatever was
;                        ringing from the previous trig" into the new
;                        capture even though HELD_WET itself no longer
;                        holds that value by the time capture runs.
;                        Fixed for the whole capture, not resampled
;                        live. Found necessary via probe_rvrs.cpp's
;                        functional check (2026-11-03) -- reading live
;                        HELD_WET directly would always see 0, since the
;                        zeroing happens first. Reclaims the slot that
;                        held WINDOW_SAMPLES_CUR during the short-lived
;                        live-DECIM-knob round.
;   Y+31 PENDING_HALF    12-bit packing (reused slot -- was free in the
;                        24-bit NFX-BO this was rebuilt from). On a
;                        CAP_STORE event whose LOGICAL position is the
;                        FIRST of its word-pair, the quantized half is
;                        stashed here (not written to memory yet); on
;                        the matching second event, it's combined with
;                        that event's own half and the complete word is
;                        written in one go -- avoids any read-modify-
;                        write on a half-complete word. Direction-aware
;                        (see CAP_STORE below) -- same exact mechanism,
;                        and the same reverse-specific pairing bug
;                        class, as NUW-JT's own (already fixed there;
;                        reused verbatim here). BOUNCE_ADVANCE does NOT
;                        need this: it always reads a complete word
;                        (both halves) before writing, so it can
;                        read-modify-write in one step every time -- no
;                        stash-and-wait needed.
;   Y+32 free -- not repurposed for anything yet.
;
; BITS is deliberately not implemented in v1 (shelved per the user). TONE
; and ALFC were both implemented at various points but removed 2026-11-03
; (see the Y+7 RVRS/DECIM comments above for the full reasoning).
;
; 12-bit sample packing (REBUILT 2026-11-06, second attempt -- see
; DESIGN.md Sec 14/15 for the full history: the first attempt, forked
; from an earlier NFX-BO snapshot, was found to be far over the real MDS
; 1.1 cycle ceiling and was shelved before this rebuild; this is a fresh
; backport starting from NFX-BO's own CURRENT, already certifier-audited
; build, not a resurrection of the shelved file). Two signed 12-bit
; samples share one 24-bit Y-memory word, doubling effective capture
; length -- see LOGICAL_BUFLEN's own .equ comment below for the headline
; reasoning. A LOGICAL sample index replaces the plain word index
; CAP_POS/BOUNCE_POS used to be: word-index = logical>>1, sub-phase =
; logical&1 (0=top 12 bits, 1=bottom 12). Quantize via asr #12 (top 12
; bits, already sign-extended); pack two quantized halves by masking
; each to #$fff and shifting the first left 12 before adding; unpack a
; half by shifting to reposition (bottom half only) then sign-extending
; (asr #12) then rescaling back to Q23 range (asl #12, bottom 12 bits
; now zero -- the quantization noise floor, SP-1200/S900-style
; character, same as NUW-JT's).
;
; CRITICAL, confirmed via direct probe on NUW-JT (dsp56300/cyclecheck/
; sign_test/shift12_isolate*.asm56k, pack12_test2.asm56k) BEFORE relying
; on it there, reused as fact here too: two consecutive immediate-shift
; instructions naming the SAME register silently merge into one NET
; shift (asr counts negative, asl positive) regardless of what
; unrelated instructions sit between them -- "asr #12,a,a" then
; "asl #12,a,a" nets to a complete no-op, not two independent shifts.
; Fix, used throughout below: alternate registers for every such pair
; (shift on b, move b1,a, shift on a) -- never two shifts in a row
; naming the same register.
;
; A characteristic this backport introduces, worth knowing about (not
; necessarily a problem, just different from before): BOUNCE's decay-
; and-write-back now re-quantizes to 12-bit on EVERY repeat, not just
; once at capture time -- there's no separate full-precision "shadow"
; copy, the packed buffer IS the only place a ringing train's value
; lives between bounces. DCAY_MULT already shrinks the signal every
; repeat and ACCUM_LEVEL/LEVEL_THRESHOLD already bounds how long a
; train can ring, so this seems unlikely to be audible as anything
; beyond "a bit more lo-fi per repeat, same spirit as the original
; 12-bit capture already trades for" -- but it hasn't been confirmed by
; ear.
;
; Fixed-point notes (empirically verified this session against the real
; dsp56300 interpreter, not assumed -- see dsp56300/cyclecheck/probe_mpy.cpp):
;   - mpy of a TRUE Q23 fraction times a PLAIN INTEGER lands correctly in a1
;     directly, no extra shift needed.
;   - mpy of two TRUE Q23 fractions also lands correctly in a1 directly.
;   - mpy of two PLAIN INTEGERS (both small, no fractional intent) needs
;     "asr a" (undo the hardware's doubled-product convention) followed by
;     "move a0,a" (relocate the recovered small integer from a0 into a1) --
;     this exact sequence is copied from NFX-EN's own confirmed-working
;     TRACKMEM pointer setup, see refs/GOLD_STANDARD.md section 3.
;   - mpy's source operands must be x0/x1/y0/y1 -- never a0/a1/b0/b1 directly.


.equ BUFLEN 1536 ; TRACK_BUFFERS words/track (hardware allocation --
             ; this is the PHYSICAL word count, unchanged by 12-bit
             ; packing below; only ever used for addressing/clearing the
             ; raw buffer itself, e.g. INIT's clear loop).
.equ LOGICAL_BUFLEN 3072 ; = BUFLEN*2, two 12-bit samples/word. Two
             ; signed 12-bit samples share one 24-bit Y-memory word,
             ; DOUBLING effective capture length for the same DECIM
             ; (e.g. ~139ms becomes ~278ms at DECIM=4). Every reference
             ; to "capture length" or "position" below is now in
             ; LOGICAL units (0..LOGICAL_BUFLEN-1), not plain word
             ; indices -- see the CAP_STORE/BOUNCE_ADVANCE header
             ; comments for the word-index/sub-phase addressing this
             ; implies, copied verbatim from NUW-JT's own already-
             ; hardware-verified pack/unpack layer.
.equ DECIM 4 ; real samples skipped per stored LOGICAL sample. RAISE
             ; this for longer, more lo-fi captures (e.g. 8=~140ms,
             ; 16=~278ms at the doubled capacity); LOWER for shorter/
             ; cleaner ones. Rebuild after editing. MUST keep
             ; DECIM_SHIFT below in sync by hand -- this project's
             ; assembler has no log2(). (Back to a plain compile-time
             ; constant 2026-11-03; briefly a live knob, dropped after a
             ; real bug in its interpolation-shift derivation -- see the
             ; RVRS/DECIM header comments above.)
.equ DECIM_SHIFT 2 ; = log2(DECIM). DECIM=1->0, 2->1, 4->2, 8->3, 16->4,
                   ; 32->5, 64->6, 128->7.
.equ DECIM_M1 3 ; = DECIM-1
.equ WINDOW_SAMPLES 12288 ; = LOGICAL_BUFLEN*DECIM (~278ms at DECIM=4 --
                          ; double the pre-12-bit ~139ms at the same
                          ; DECIM, the whole point of this backport)
.equ GAP_FLOOR 8 ; provisional -- re-measure cycle cost before trusting
.equ GAP_CEIL 220500 ; 5 seconds -- raised from the original 1-second
                     ; default, which was clamping BEND's grow/decelerate
                     ; side well before the brief's "very slow, 1-2
                     ; repeats per bar" territory, felt as an artificial
                     ; ceiling. This only affects RATE's own max knob
                     ; value and the absolute clamp BEND can't exceed --
                     ; free to raise further, no cycle cost either way.
.equ GAP_RANGE 220492 ; = GAP_CEIL-GAP_FLOOR, precomputed: the raw assembler
                     ; doesn't accept a parenthesized expression as an
                     ; immediate operand
.equ FIRST_GAP_FLOOR 32 ; 2026-11-06 guard, see the RATE/trig-reset block
                     ; below for the full reasoning -- this is NOT the same
                     ; thing as GAP_FLOOR (8) above. GAP_FLOOR still governs
                     ; every BEND-shrunk steady-state restart once a train
                     ; is rolling; this separate, higher floor applies ONLY
                     ; to the very first post-trigger gap, so an aggressive
                     ; RATE can never let the first restart land in the
                     ; SAME 32-sample block as this trigger's own one-time
                     ; setup cost (RVRS's LFSR draw, GATE/CAP_POS
                     ; derivation) -- confirmed via the real mds-certifier
                     ; as this machine's actual worst-case block (see
                     ; refs/GOLD_STANDARD.md Sec 6). One full RENDER block
                     ; (32 samples, ~0.7ms) is an inaudible difference from
                     ; GAP_FLOOR's own 8 (~0.18ms) as a ONE-TIME delay
                     ; before the very first repeat, not a change to
                     ; RATE/BEND's steady-state behavior at all.
.equ DCAY_CEIL_Q23 $7eb852 ; 0.99 in Q23 (brief's explicit max)
.equ HALF_Q23 $400000 ; 0.5, BEND's grow/shrink rate
.equ LEVEL_THRESHOLD $000800 ; ~-72dB, below this the train is done
.equ MAXREPEATS 8192 ; safety cap, not the normal stop condition


INIT:
        ; TRACKMEM base = r1 * 1536, rounded up to the next 512-word boundary.
        ; This exact sequence mirrors NFX-EN's own confirmed-working INIT --
        ; see refs/GOLD_STANDARD.md section 3.
        ; CRITICAL: mpy's operand pairing matters on real hardware --
        ; "mpy y0,y1,a" (both Y-file registers) silently returns ZERO on
        ; every input, confirmed by direct probe (dsp56300/cyclecheck/
        ; probe_mpy2.cpp). This was the root cause of a real hardware bug:
        ; every track ended up computing the SAME (track 0's) TRACKMEM
        ; base, so a second instance on another track stomped the first's
        ; buffer. Only "mpy y0,x0,a" (one X-file, one Y-file register) is
        ; used anywhere in this file now -- do not reintroduce a y0,y1 (or
        ; any same-file) pairing without re-verifying it against the probe.
        move r1,y0 ; r1 = this track's number (0-15)
        move #>BUFLEN,x0
        mpy y0,x0,a ; confirmed-correct pairing
        asr a
        move a0,a ; relocate the small product into a1
        move a1,y1 ; y1 = track_number*1536 (plain integer offset)
TRACKMEM:
        move #>$0,x0 ; placeholder, patched by the loader to track 0's
                     ; TRACK_BUFFERS base (kind-2 import, symbol 6 -- a
                     ; plain patched immediate, NOT a service call)
        move y1,a
        add x0,a ; + the patched track-0 base (spec's exact formula,
                  ; no extra rounding needed for our own addressing)
        move a1,r0
        move r0,y:(r6+$9)

        ; clear this track's whole TRACK_BUFFERS region -- it may hold
        ; another machine's data (spec: "clear it before reading").
        move #>$ffffff,m0
        clr a
        rep #BUFLEN
        move a,y:(r0)+

        clr a
        move a,y:(r6+$a)
        move a,y:(r6+$b)
        move a,y:(r6+$c)
        move a,y:(r6+$d)
        move a,y:(r6+$e)
        move a,y:(r6+$f)
        move a,y:(r6+$10)
        move a,y:(r6+$11)
        move a,y:(r6+$12)
        move a,y:(r6+$13)
        move a,y:(r6+$14)
        move a,y:(r6+$15)
        move a,y:(r6+$16)
        move a,y:(r6+$17)
        move a,y:(r6+$18)
        move a,y:(r6+$19)
        move a,y:(r6+$1a)
        move a,y:(r6+$1b)
        move a,y:(r6+$1d)
        move a,y:(r6+$1e)
        move a,y:(r6+$1f) ; PENDING_HALF (12-bit packing -- not strictly
                          ; required since the write-pairing invariant
                          ; always writes this before it's ever read,
                          ; but cleared anyway for consistency with
                          ; NUW-JT's own INIT)
        ; RNG_STATE (Y+28/$1c) must NOT be zero -- a Galois LFSR seeded
        ; at 0 is a fixed point (lsl(0)=0, carry always 0, so eor never
        ; fires: it would stay 0 forever, making RVRS's draw silently
        ; deterministic on every track forever). Caught before shipping
        ; via probe_rvrs.cpp's 50/50 sanity check. Same arbitrary nonzero
        ; seed pluck.asm56k itself uses for the identical idiom (its own
        ; comment: "any nonzero noise state").
        move #>$5a5a5a,x0
        move x0,y:(r6+$1c)
        rts

TRIG:
        ; one-shot flag, consumed once by RENDER (CH's idiom -- see
        ; refs/GOLD_STANDARD.md section 1). RENDER does the actual state
        ; reset so TRIG itself stays trivially cheap.
        move #>$1,x0
        move x0,y:(r6+$b)
        rts

RENDER:
        ; --- once per block: consume a fresh trig, if any ---
        move y:(r6+$b),a
        tst a
        beq <RENDER_NOTRIG
        clr a
        move a,y:(r6+$b)

        ; --- RVRS: decide this trig's REVERSE_FLAG once, before GATE's
        ; own code just below (which needs to know CAP_REMAIN's final
        ; value before it can set CAP_POS's starting point -- that part
        ; happens in GATE_DONE, not here; here we only decide the
        ; direction). x0/x1/y0/y1/a/b are all free scratch here, same
        ; once-per-trig preamble spot the old DECIM derivation used to
        ; occupy.
        ;
        ; RVRS is bipolar_q23: -max=ALWAYS reverse, +max=NEVER reverse,
        ; 0=50/50, every value between is the probability. Special-case
        ; both exact extremes (same discipline as GATE/BEND's own
        ; $800000 edge case and MIX's knob=127 snap elsewhere in this
        ; file) so "always"/"never" are exact, not merely "almost
        ; certain" -- skips the RNG draw entirely in both cases.
        move y:(r6+$7),x0 ; RVRS param, raw bipolar_q23
        move x0,a
        cmp #>$800000,a
        beq <RVRS_ALWAYS
        ; bipolar_q23's own knob=127-short-of-true-ceiling value is
        ; $7e0000, NOT $7f0000 (that's unipolar's different knob<<16
        ; shortfall, e.g. MIX elsewhere in this file) -- bipolar's raw
        ; encoding is (knob-64)<<17 per the MDS spec ("0 becomes -1, 64
        ; becomes zero"), so knob=127 -> 63<<17 = $7e0000.
        cmp #>$7e0000,a
        bge <RVRS_NEVER

        ; general case: p_reverse = (1-RVRS)/2. (1-RVRS) can reach 2.0
        ; for RVRS near -1, unrepresentable directly in Q23 -- same
        ; "subtract in the full accumulator first, shift/scale once at
        ; the end" pattern already proven elsewhere in this file (the
        ; interpolation-step and anti-alias-filter fixes) rather than
        ; risking a truncated intermediate.
        move #>$7fffff,a
        sub x0,a ; a = 1-RVRS, full accumulator, up to 2.0 -- not yet
                 ; truncated, so this cannot overflow
        asr a ; a = (1-RVRS)/2, now safely in [0,1] -- single truncation
        move a1,y0 ; y0 = p_reverse, stashed across the LFSR mix below
                   ; (which only touches a/b/x1) so it survives untouched
        bra <RVRS_DRAW
RVRS_ALWAYS:
        move #>1,a
        move a1,y:(r6+$1b) ; REVERSE_FLAG=1, skip the RNG draw entirely
        bra <RVRS_DONE
RVRS_NEVER:
        clr a
        move a1,y:(r6+$1b) ; REVERSE_FLAG=0
        bra <RVRS_DONE
RVRS_DRAW:
        ; advance RNG_STATE via a Galois LFSR (taps x^24+x^23+x^22+x^17+1,
        ; $c20001) -- the shift/eor idiom itself is MDS's own official
        ; example machine's noise generator (MDS/machines/examples/
        ; imports/pluck.asm56k, "a 24-bit shift-register noise source"),
        ; reused rather than inventing a new RNG. UNROLLED by hand here,
        ; NOT wrapped in a hardware "do" loop like pluck.asm56k's own
        ; usage: measured directly via the cycle-check harness, a
        ; hardware do-loop around this exact lsl/bcc/eor body (8
        ; iterations) cost ~4600 EXTRA cycles here -- confirmed via
        ; isolated A/B scenarios (skipping the loop entirely cost the
        ; same as a normal fresh trig; running it cost +4600) -- while
        ; the identical shape ran correctly and cheaply as a standalone
        ; probe (dsp56300/cyclecheck/sign_test/lfsr_test3.asm56k). That
        ; points at a loop-counting hazard specific to a conditional
        ; branch inside a hardware do-loop on this toolchain/emulator
        ; (possibly latent in pluck.asm56k too, just inaudible there) --
        ; rather than chase that further, sidestepping it entirely by
        ; unrolling, the SAME plain-branch construct already proven safe
        ; everywhere else in this file.
        move y:(r6+$1c),b ; RNG_STATE
        move #>$c20001,x1
        lsl b
        bcc <RVRS_MIX1_KEEP
        eor x1,b
RVRS_MIX1_KEEP:
        lsl b
        bcc <RVRS_MIX2_KEEP
        eor x1,b
RVRS_MIX2_KEEP:
        lsl b
        bcc <RVRS_MIX3_KEEP
        eor x1,b
RVRS_MIX3_KEEP:
        lsl b
        bcc <RVRS_MIX4_KEEP
        eor x1,b
RVRS_MIX4_KEEP:
        lsl b
        bcc <RVRS_MIX5_KEEP
        eor x1,b
RVRS_MIX5_KEEP:
        lsl b
        bcc <RVRS_MIX6_KEEP
        eor x1,b
RVRS_MIX6_KEEP:
        lsl b
        bcc <RVRS_MIX7_KEEP
        eor x1,b
RVRS_MIX7_KEEP:
        lsl b
        bcc <RVRS_MIX8_KEEP
        eor x1,b
RVRS_MIX8_KEEP:
        move b1,y:(r6+$1c) ; store the advanced RNG_STATE
        move b1,a
        and #>$7fffff,a ; fold into a unipolar fraction in [0,~1) --
                        ; discards only the sign bit, no negation needed
        move a1,x0 ; x0 = rng_fraction
        move y0,a ; a = p_reverse (stashed above)
        cmp x0,a
        bgt <RVRS_FLAG_SET ; rng_fraction < p_reverse -> reverse
        clr a
        move a1,y:(r6+$1b) ; REVERSE_FLAG=0
        bra <RVRS_DONE
RVRS_FLAG_SET:
        move #>1,a
        move a1,y:(r6+$1b) ; REVERSE_FLAG=1
RVRS_DONE:

        ; GATE shapes the capture window (see DESIGN.md section 7): both
        ; directions reduce to the same "missing = LOGICAL_BUFLEN*|g|"
        ; magnitude (LOGICAL_BUFLEN, not BUFLEN, since GATE now shapes a
        ; LOGICAL sample count -- 12-bit packing); the sign only decides
        ; whether the missing chunk becomes a start delay (GATE>0) or is
        ; simply never captured (GATE<0).
        move y:(r6+$2),x0
        move x0,a
        tst a
        bge <GATE_POS
        ; CRITICAL: "neg a" does NOT correctly negate a value loaded via
        ; "move y:addr,a" on this hardware -- the accumulator's extension
        ; bits aren't sign-extended by that load, so negating the full
        ; (wrongly-positive-looking) extended value leaves a1 unchanged.
        ; Confirmed by direct probe (dsp56300/cyclecheck/sign_test/
        ; neg_test.asm56k): neg on $800000 loaded this way gave $800000
        ; back, not $800000's true negation. Fix: negate via a clean
        ; zero accumulator against the ORIGINAL data register instead
        ; (the same "clr a / sub x0,a" shape already proven correct
        ; elsewhere, e.g. the 1-MIX calc).
        ; Q23 can't represent +1.0 (max is $7fffff), so negating the exact
        ; extreme -1.0 ($800000, a real reachable knob position per spec:
        ; "0 becomes -1") would overflow right back to $800000. Checking
        ; the SIGN of that overflowed result with "tst/bge" does NOT catch
        ; it -- confirmed by direct probe (clamp_test.asm56k) that "bge"
        ; takes the branch anyway after this specific overflow, because
        ; signed bge is overflow-aware (N xor V) and the TRUE mathematical
        ; result (+8388608) really is >=0, even though it can't fit in 24
        ; bits. So: special-case the one bad input via exact equality
        ; (zero-flag based, not overflow-sensitive -- confirmed via
        ; eq_test.asm56k) BEFORE attempting the subtraction at all.
        cmp #>$800000,a
        beq <GATE_NEG_MIN
        clr a
        sub x0,a
        bra <GATE_NEG_OK
GATE_NEG_MIN:
        move #>$7fffff,a
GATE_NEG_OK:
        move a1,y0 ; y0 = |GATE|
        move #>LOGICAL_BUFLEN,x0
        mpy y0,x0,a ; true fraction * plain integer: a1
                                         ; lands correctly, no shift needed
        move a1,x0 ; x0 = missing LOGICAL samples
        move #>LOGICAL_BUFLEN,a
        sub x0,a ; a = CAP_REMAIN = LOGICAL_BUFLEN - missing
        move a1,y:(r6+$d)
        move a1,y:(r6+$10)
        clr a
        move a,y:(r6+$f) ; GATE<0: stop early, no start delay
        bra <GATE_DONE
GATE_POS:
        move a1,y0 ; y0 = GATE (already >=0)
        move #>LOGICAL_BUFLEN,x0
        mpy y0,x0,a
        move a1,x1 ; x1 = missing LOGICAL samples
        move #>LOGICAL_BUFLEN,a
        sub x1,a ; a = CAP_REMAIN = LOGICAL_BUFLEN - missing
        move a1,y:(r6+$d)
        move a1,y:(r6+$10)
        move x1,y1 ; y1 = missing LOGICAL samples (mpy needs an
                                         ; x0/x1/y0/y1 source, never a0/a1)
        move #>DECIM,x0
        mpy y1,x0,a ; plain int * plain int -- small
        asr a
        move a0,a ; relocate into a1
        move a1,y:(r6+$f)
GATE_DONE:
        ; CAP_POS's starting point depends on REVERSE_FLAG (decided
        ; above, in the once-per-trig RVRS preamble): forward captures
        ; start at word 0 and count up as always; reversed captures
        ; start at the LAST word this trig will actually write
        ; (CAP_REMAIN-1, already final by this point) and count down,
        ; so BOUNCE -- which always reads forward from buffer[0]
        ; unchanged -- plays the captured content back reversed with no
        ; changes to playback logic at all.
        move y:(r6+$1b),a ; REVERSE_FLAG
        tst a
        bne <GATE_CAPPOS_REV
        clr a
        move a,y:(r6+$c) ; forward: CAP_POS=0
        bra <GATE_CAPPOS_DONE
GATE_CAPPOS_REV:
        move y:(r6+$d),a ; CAP_REMAIN, final value as of just above
        sub #>1,a
        move a1,y:(r6+$c) ; reverse: CAP_POS=CAP_REMAIN-1 (if CAP_REMAIN
                          ; is 0, this is never dereferenced -- CAP_STORE
                          ; is already gated on CAP_REMAIN>0 regardless
                          ; of direction)
GATE_CAPPOS_DONE:
        move #>WINDOW_SAMPLES,x0
        move x0,y:(r6+$1d) ; CAP_WINDOW_REMAIN = WINDOW_SAMPLES (counts
                           ; down, not up -- cheaper per-sample check,
                           ; see below)
        move #>DECIM_M1,x0
        move x0,y:(r6+$e)
        move #>1,a
        move a,y:(r6+$a) ; PHASE = ACTIVE (capture and bounce now run
                         ; concurrently, each gated on its own state --
                         ; see the per-sample loop; PHASE itself is just
                         ; "has a train been triggered and not yet fully
                         ; decayed", 0=IDLE 1=ACTIVE)

        ; RATE sets the gap before repeat 1, counted from THIS instant
        ; (the trig/start of capture), not from whenever capture happens
        ; to finish -- user's explicit correction: "R should count from
        ; the BEGINNING of the step that is being captured." The gap
        ; countdown below runs unconditionally once PHASE=ACTIVE,
        ; independent of capture's own progress; capture keeps running
        ; concurrently on its own clock (see CAP_WINDOW_REMAIN below),
        ; never cut short -- the two don't interact at all. (This also
        ; cancels whatever bounce was mid-flight; fresh trig always
        ; starts over, per the brief.)
        move y:(r6+$3),y0 ; already-squared true fraction
        move #>GAP_RANGE,x0
        mpy y0,x0,a ; fraction * plain integer, no shift
        move #>GAP_FLOOR,x0
        add x0,a
        ; GUARD (2026-11-06): floor the FIRST post-trigger gap to one full
        ; block (FIRST_GAP_FLOOR=32), not GAP_FLOOR(8) -- see that .equ's
        ; own comment for the full reasoning. Cheap: once per trig, not
        ; once per sample.
        cmp #>FIRST_GAP_FLOOR,a
        bge <FIRST_GAP_OK
        move #>FIRST_GAP_FLOOR,a
FIRST_GAP_OK:
        move a1,y:(r6+$14)
        move a1,y:(r6+$13)

        ; snapshot whatever HELD_WET is ringing right NOW, before it gets
        ; zeroed just below -- CAP_STORE reads this snapshot (not live
        ; HELD_WET) for the layered-capture blend. HELD_WET itself still
        ; needs to be zeroed here regardless (see the comment on that
        ; line): it also feeds BOUNCE's own audible output ramp, and a
        ; fresh trig must NOT leak the old train's amplitude into the new
        ; one's first streamed samples. These are two different
        ; consumers of "what was ringing" with different needs -- a
        ; single live word can't serve both once the old train is being
        ; cancelled for one purpose but captured for the other. This
        ; snapshot is a one-time value for the whole capture (not
        ; resampled live), matching the brief's own framing: a blend
        ; taken at the moment of the new trig, not a continuously-varying
        ; sum.
        move y:(r6+$19),x0
        move x0,y:(r6+$1e) ; PREV_WET_SNAPSHOT
        clr a
        move a,y:(r6+$11) ; BOUNCE_POS=0
        move a,y:(r6+$12) ; BOUNCE_DECIM_CTR=0
        move a,y:(r6+$15) ; SAMPLES_REMAINING=0 -- nothing streams until
                          ; the gap countdown above reaches zero
        move a,y:(r6+$18) ; REPEATS_FIRED=0 (NOT redundant -- the BOUNCE
                          ; restart logic reads this directly, nothing
                          ; else resets it)
        move a,y:(r6+$19) ; HELD_WET=0 -- found by naive review: without
                          ; this, a fresh trig that interrupts a still-
                          ; audible bounce train leaks that OLD train's
                          ; ramped amplitude into the new one's first
                          ; streamed samples, in tension with "whatever
                          ; was still playing is cancelled, starts
                          ; completely fresh."
        move a,y:(r6+$1a) ; INTERP_STEP=0, same reasoning
        move #>$7fffff,a
        move a,y:(r6+$17)
RENDER_NOTRIG:

        ; --- once per block: DCAY's multiplier, scaled to its 0.99 ceiling ---
        move y:(r6+$5),x0
        move #>DCAY_CEIL_Q23,y0
        mpy x0,y0,a ; true fraction * true fraction
        move a1,y:(r6+$16)
        move a1,n4 ; n4 = cached DCAY_MULT -- re-read from Y-memory up to
                   ; 8x/block in BOUNCE_ADVANCE (12-bit packing's TOP/
                   ; BOTTOM dual path both need it) plus the restart
                   ; ACCUM_LEVEL check; caching it once per block in a
                   ; spare register (confirmed free) carried over
                   ; unchanged from the 24-bit NFX-BO this was rebuilt
                   ; from. No audible change at all, purely an
                   ; implementation efficiency win.

        ; (TONE's HPF_K/1-HPF_K and ALFC's LPF_K/ONE_MINUS_LPF_K setup
        ; used to be cached here, once per block, into n2/n4/n5/n6 --
        ; removed 2026-11-03 along with TONE and ALFC themselves. n2/n4/
        ; n5/n6 are free scratch registers again.)

        ; --- neighbour buffers for this block's dry signal (NBAL) --
        ; carried forward from the old build's confirmed-good linear
        ; crossfade -- see DESIGN.md section 2.
        move y:>$7f0,r5
        move #>$ffffff,m5
        move y:(r5+2),r2 ; two back
        move y:(r5+1),r5 ; one back
        move #>$ffffff,m2

        move y:(r6+$9),r3 ; r3 = this track's buffer base,
        move #>$ffffff,m3 ; reused each sample below; must be
                                         ; linear, RENDER does not reset M3

        ; --- once per block: NBAL and MIX are per-block constants, but
        ; the per-sample loop was recomputing/re-fetching their derived
        ; values on all 32 samples every time (found via a naive review
        ; against the stock machines' own hot loops, which always hoist
        ; anything block-constant into a spare register ONCE rather than
        ; re-deriving it per sample). Cache them here instead -- r1, r4,
        ; n0, n1 are all otherwise unused anywhere in RENDER_LOOP.
        move #>$7fffff,a
        move y:(r6+$1),y0 ; NBAL
        sub y0,a ; a = 1-NBAL
        move a1,n0 ; n0 = cached 1-NBAL
        move y:(r6+$1),n1 ; n1 = cached NBAL

        ; MIX, with the same knob=127-snaps-to-exactly-zero-dry fix as
        ; before, just computed once per block instead of once per sample.
        move y:(r6+$6),a ; MIX
        ; firmware's unipolar_q23 encoding of knob=127 (knob<<16) is
        ; short of Q23's true $7fffff ceiling, so a plain 1-MIX calc
        ; leaves a small dry residual at max knob position; snap to
        ; exactly zero there instead.
        cmp #>$7f0000,a
        bge <PRE_MIX_FULL_WET
        move #>$7fffff,a
        move y:(r6+$6),x0
        sub x0,a
        move a1,r1 ; r1 = cached 1-MIX
        bra <PRE_MIX_DONE
PRE_MIX_FULL_WET:
        clr a
        move a1,r1 ; r1 = cached 1-MIX (exactly zero, full wet)
PRE_MIX_DONE:
        move y:(r6+$6),r4 ; r4 = cached MIX

RENDER_LOOP:
        do #32,RENDER_END
        ; dry = two_back*(1-NBAL) + one_back*NBAL
        ;
        ; CRITICAL: this used to be computed as "two_back + NBAL*(one_back
        ; -two_back)", truncating the (one_back-two_back) delta to a1
        ; immediately -- the SAME overflow bug as the anti-alias filter
        ; above (see that comment for the full explanation): the delta can
        ; mathematically reach +/-2.0, overflowing Q23's +/-1.0 range, and
        ; wraps to a corrupted value on exactly the kind of sharp transient
        ; a real drum hit produces. Reported on hardware as the DRY signal
        ; itself sounding like "a very very low quality copy." Rewritten
        ; as a convex combination (same proof of safety as the filter
        ; above and the dry/wet output mix below: weights 1-NBAL and NBAL
        ; are both >=0 and sum to 1, so the result is bounded by whichever
        ; input has the larger magnitude -- cannot overflow).
        move y:(r2)+,x0 ; x0 = two_back
        move y:(r5)+,y1 ; y1 = one_back
        move n0,y0 ; y0 = cached 1-NBAL (hoisted above, block-constant)
        mpy x0,y0,a ; a = two_back*(1-NBAL)
        move n1,x0 ; x0 = cached NBAL
        macr y1,x0,a ; a += one_back*NBAL -- convex combo, cannot
                     ; overflow; macr accumulates directly onto the
                     ; running a, no stash-through-b needed (confirmed-
                     ; safe pairing: y-file*x-file, same as elsewhere)
        move a1,x1 ; x1 = dry sample, kept for the tail

        ; b defaults to silence (this sample's wet output) regardless of
        ; what follows -- must run unconditionally, even on fully-idle
        ; samples, since the output mix at the end of this loop always
        ; reads it.
        clr b

        ; --- single shared gate: PHASE=0 (fully idle) skips BOTH the
        ; capture logic below AND the bounce logic after it in one
        ; check, instead of each block separately re-testing phase.
        ; Once a trig has fired (PHASE=ACTIVE), capture and bounce run
        ; CONCURRENTLY -- not as mutually-exclusive phases -- each gated
        ; only by its own internal state (CAP_WINDOW_REMAIN for capture,
        ; GAP_REMAIN for bounce). This is the redesign for "R should
        ; count from the beginning of the step being captured": the gap
        ; countdown no longer waits for capture to finish at all, and
        ; capture is never cut short by it either -- the write-head
        ; (capture) and read-head (bounce playback) advance at the exact
        ; same rate once bounce starts, so the write-head -- already
        ; ahead by however many samples elapsed before bounce began --
        ; stays ahead for the rest of the window; bounce can never read
        ; past what's actually been captured.
        move y:(r6+$a),a
        tst a
        ; 2026-11-06: routed through a short-branch RELAY, not a direct
        ; "beq <SKIP_BOUNCE" -- the 12-bit packing backport's extra code
        ; in CAP_STORE/BOUNCE_ADVANCE between here and SKIP_BOUNCE pushes
        ; that distance past the short branch's +/-255-word range, the
        ; SAME real hardware-freeze-causing issue this exact backport hit
        ; before (a `jeq` absolute jump inside this hardware `do` loop --
        ; see [[reference_dsp56300_jcc_doloop_restriction]] / DESIGN.md
        ; Sec 14 for the full history). Applying the fix PROACTIVELY this
        ; rebuild, not waiting to rediscover it: a plain `beq` to a nearby
        ; relay label that itself does a plain `bra` on to the real
        ; target, both hops using ONLY the short-branch form, never a
        ; Jcc/JMP/JSET/JCLR inside this loop.
        beq <RENDER_LOOP_SKIP_RELAY

        ; --- CAPTURE: store a decimated word, when its own state says so ---

        ; CAPTURE's DURATION is fixed real time (WINDOW_SAMPLES),
        ; independent of GATE -- NOT however many words CAP_REMAIN says
        ; still need storing (GATE is only supposed to select what gets
        ; captured, never affect timing at all -- see BRIEF.md). This
        ; countdown is now ALSO independent of bounce entirely: once it
        ; hits zero, capture just stops storing for the rest of this
        ; trig (falls through to SKIP_CAPTURE below every sample from
        ; then on) -- it does NOT touch PHASE or anything bounce-related.
        move y:(r6+$1d),a
        sub #>1,a
        move a1,y:(r6+$1d)
        ; no separate "tst a" needed -- a plain "move" does not affect
        ; the condition codes on this hardware (confirmed via the real
        ; asm56.exe toolchain + dsp56300 interpreter, dsp56300/cyclecheck/
        ; sign_test/move_flags_test.asm56k), so "sub"'s own flags are
        ; still valid here.
        ;
        ; REAL BUG, found 2026-11-04 while backporting 12-bit sample
        ; packing to a sibling build (NFX-BO) -- NOT caused by that
        ; backport, a pre-existing defect in THIS file, present through
        ; all 12 rounds of this project's own hardware testing, just
        ; never caught (losing 1 word out of 1536 at the very tail of a
        ; long, GATE/RATE/BEND-variable capture is easy to miss by
        ; ear). MUST be "blt" (strictly negative), not "ble": with
        ; "ble", CAP_WINDOW_REMAIN hitting EXACTLY 0 ends capture on the
        ; SAME sample as the window's own last valid decimated event,
        ; dropping it entirely -- the exact same off-by-one NUW-JT's
        ; own window-boundary fix (round 2, 2026-11-04) already found
        ; and fixed in that file; only found here because NUW-JT's own
        ; "verify the exact last word" probe discipline got applied to
        ; this file's buffer too while adapting it for NFX-BO. "blt"
        ; lets CAP_WINDOW_REMAIN reach exactly 0 on a still-valid
        ; sample and only ends capture once it goes negative, giving
        ; the full WINDOW_SAMPLES samples of processing. Confirmed via
        ; probe_nfxbo.cpp (12-bit sibling, same underlying logic):
        ; the last word came back as 0 (never written) before this
        ; fix, correct after.
        blt <SKIP_CAPTURE

        ; (The anti-alias LPF cascade and TONE's highpass used to run
        ; here, every real sample while capturing -- removed 2026-11-03.
        ; The real fix for decimation aliasing turned out to be DECIM
        ; itself [raising the Nyquist directly, now a fixed compile-time
        ; value -- see the .equ above], not filtering before capture: a
        ; kick's pitch-envelope sweep crosses whatever Nyquist is in
        ; effect on every hit, and no FIXED filter cutoff can suppress a
        ; sweep at the exact instant it's crossing, confirmed via
        ; spectrogram before this change. CAP_STORE below now stores
        ; dry layered with whatever bounce is still ringing from a
        ; PREVIOUS trig, not a filtered copy -- see CAP_STORE itself.)

        move y:(r6+$f),a
        tst a
        ble <CAP_ACTIVE
        sub #>1,a
        move a1,y:(r6+$f)
        bra <SKIP_CAPTURE
CAP_ACTIVE:
        ; CAP_REMAIN<=0 now just means "nothing left to store this trig"
        ; -- it no longer ends the phase (see the CAP_ELAPSED/
        ; WINDOW_SAMPLES check above, which is the only thing that does
        ; that now). Simply idle (dry still plays, nothing gets written)
        ; until the fixed window elapses.
        move y:(r6+$d),a
        tst a
        ble <SKIP_CAPTURE
        move y:(r6+$e),a
        tst a
        ble <CAP_STORE
        sub #>1,a
        move a1,y:(r6+$e)
        bra <SKIP_CAPTURE
CAP_STORE:
        move #>DECIM_M1,a
        move a1,y:(r6+$e)

        ; layered capture: sum dry(x1) + whatever bounce was still
        ; ringing from a PREVIOUS trig, in the full accumulator (bounded
        ; to +/-2.0, cannot wrap) then clamp back into Q23 range before
        ; storing. When nothing was ringing (snapshot~=0) this reduces
        ; to plain x1 -- today's unchanged level, not an attenuated
        ; blend (a fixed-ratio convex combination was considered and
        ; rejected: it would halve the captured level whenever nothing
        ; is ringing, the common case).
        ;
        ; Reads PREV_WET_SNAPSHOT (Y+30), NOT live HELD_WET (Y+25) --
        ; found via probe_rvrs.cpp's functional check, a real bug caught
        ; before shipping: a fresh trig unconditionally zeroes HELD_WET
        ; (see the RATE/trig-reset block above) so BOUNCE's own audible
        ; output doesn't inherit the OLD train's stale amplitude. Reading
        ; HELD_WET itself here would therefore see 0 for the first store
        ; after every single trig -- the one-time snapshot taken right
        ; before that zeroing is what actually carries "whatever was
        ; ringing" into this capture; it's deliberately a fixed value for
        ; the whole capture, not resampled live sample-to-sample.
        move y:(r6+$1e),x0 ; PREV_WET_SNAPSHOT
        move x1,a
        add x0,a ; + PREV_WET_SNAPSHOT
        cmp #>$7fffff,a
        ble <CAPSTORE_CLAMP_LO
        move #>$7fffff,a
CAPSTORE_CLAMP_LO:
        cmp #>$800000,a
        bge <CAPSTORE_CLAMPED
        move #>$800000,a
CAPSTORE_CLAMPED:
        asr #12,a,a ; quantize to signed 12-bit (12-bit packing -- see
                    ; the header comment above INIT for the full writeup)
        move a1,y1 ; y1 = blended, clamped, quantized half to store

        ; --- 12-bit write pairing: same mechanism, and the same
        ; reverse-specific pairing bug class (already found and fixed
        ; there), as NUW-JT's own CAPTURE_WRITE -- reused verbatim, not
        ; re-derived. word-index = CAP_POS>>1, sub_phase = CAP_POS&1;
        ; each event positions its OWN value into its correct 12-bit
        ; slot first (direction-independent), then separately decides
        ; whether IT is the first or second half of its pair based on
        ; direction: first_of_pair = (sub_phase == REVERSE_FLAG). ---
        move y:(r6+$c),a ; CAP_POS
        asr #1,a,a ; word-index = CAP_POS>>1 (single shift, safe)
        move a1,n3

        move y:(r6+$c),a
        and #>1,a ; sub_phase = CAP_POS&1 -- and's own flags survive a
                  ; plain move (confirmed via direct probe on NUW-JT,
                  ; and_flags_direct_test.asm56k), no tst needed
        move a1,x0 ; x0 = sub_phase (0 or 1)
        bne <CAPSTORE_WPAIR_BOTTOM

        ; sub_phase=0: this event's value belongs in the TOP slot
        move y1,a
        and #>$fff,a
        asl #12,a,a
        move a1,y1 ; y1 = this event's value, positioned
        bra <CAPSTORE_WPAIR_POS_DONE
CAPSTORE_WPAIR_BOTTOM:
        ; sub_phase=1: this event's value belongs in the BOTTOM slot
        ; (no shift needed)
        move y1,a
        and #>$fff,a
        move a1,y1 ; y1 = this event's value, positioned
CAPSTORE_WPAIR_POS_DONE:

        move y:(r6+$1b),a ; REVERSE_FLAG
        cmp x0,a
        beq <CAPSTORE_FIRST_OF_PAIR

        ; second of pair: combine with the first half (already
        ; positioned when it was stashed) and write the complete word
        ; -- n3 still holds this step's word-index, untouched since it
        ; was set above.
        move y:(r6+$1f),a ; PENDING_HALF (already positioned)
        add y1,a ; a = packed word (the two positioned halves never
                 ; overlap in bits, so this is equivalent to an OR)
        move a1,y:(r3+n3)
        bra <CAPSTORE_ADVANCE
CAPSTORE_FIRST_OF_PAIR:
        ; first of pair: stash this event's (already-positioned) value,
        ; don't touch memory yet
        move y1,a
        move a1,y:(r6+$1f) ; PENDING_HALF
CAPSTORE_ADVANCE:

        ; direction depends on REVERSE_FLAG (decided once per trig;
        ; GATE_DONE already set CAP_POS's starting point to match).
        ; x0 now holds sub_phase (from the write-pairing above), not
        ; CAP_POS any more -- CAP_POS is re-read into free scratch y1
        ; (its old value already consumed above), same "plain move
        ; doesn't touch CCR" trick (move_flags_test.asm56k) still
        ; applies without needing to separately verify a MEMORY load
        ; does too.
        move y:(r6+$c),y1 ; CAP_POS, into free scratch
        move y:(r6+$1b),a ; REVERSE_FLAG
        tst a
        move y1,a ; a = CAP_POS -- plain register-to-register move,
                  ; tst's flags above are still valid at the branch
                  ; just below
        bne <CAPSTORE_REV
        add #>1,a
        bra <CAPSTORE_POS_DONE
CAPSTORE_REV:
        sub #>1,a
CAPSTORE_POS_DONE:
        move a1,y:(r6+$c)
        move y:(r6+$d),a
        sub #>1,a
        move a1,y:(r6+$d)
        bra <SKIP_CAPTURE
; --- relay point for the shared PHASE=0 gate at the top of this loop
; (see that comment for the full reasoning) -- reached ONLY via the
; `beq <RENDER_LOOP_SKIP_RELAY>` at the top, never by normal fallthrough
; (the `bra <SKIP_CAPTURE>` immediately above jumps past this
; unconditionally on every other path). Exists purely so that "skip all
; the way to SKIP_BOUNCE" can be done in two SHORT hops instead of one
; long/absolute jump -- this point sits within +/-255 words of both the
; gate check above and SKIP_BOUNCE below.
RENDER_LOOP_SKIP_RELAY:
        bra <SKIP_BOUNCE
SKIP_CAPTURE:

        ; --- BOUNCE: gap countdown always runs, from the trig itself
        ; onward, regardless of whether capture (above) is still active
        ; -- already confirmed active by the shared PHASE check earlier
        ; in this loop, no separate re-check needed here. ---

        ; gap countdown -- may restart a repeat even if one is still streaming.
        ; CRITICAL: the decrement must be written back on EVERY sample, not
        ; only when a restart happens -- without this, GAP_REMAIN never
        ; actually counts down in memory (each sample re-reads the same
        ; stale value, decrements it in a register, and discards it), so
        ; the gap never expires and only the first (directly-kicked-off)
        ; bounce ever plays. Found via dynamic simulation (sim_nfxbo_v1),
        ; not by inspection -- gapRemain was observed stuck at its initial
        ; value for 700+ blocks straight.
        move y:(r6+$13),a
        sub #>1,a
        move a1,y:(r6+$13)
        ; same "move doesn't touch CCR" fact as the CAP_WINDOW_REMAIN
        ; check above -- no separate "tst a" needed.
        bgt <GAP_KEEP
        ; restart: compute the next gap via BEND, then begin a fresh pass
        move y:(r6+$4),x0
        move x0,a
        tst a
        bge <BEND_GROW
        ; "neg a" is wrong here for the same reason as GATE's negative
        ; branch above -- see that comment. Also same Q23 extreme-negation
        ; overflow trap as GATE's branch (bge is overflow-aware and will
        ; NOT catch the $800000-stays-$800000 case) -- same exact-equality
        ; pre-check fix.
        cmp #>$800000,a
        beq <BEND_NEG_MIN
        clr a
        sub x0,a
        bra <BEND_NEG_OK
BEND_NEG_MIN:
        move #>$7fffff,a
BEND_NEG_OK:
        ; Compress the shrink range so the WHOLE knob travel (0 to -64)
        ; produces a smooth, continuously-varying effect with no flat/
        ; clamped region anywhere -- user reported the knob was saturating
        ; (reaching max effective shrink, with no further change) around
        ; display -40 out of the true minimum -64, and explicitly wants
        ; the value that USED to appear at -40 to now appear at -64
        ; instead, smoothly spread across the full travel in between (an
        ; earlier attempt that STRETCHED the input and clamped past a
        ; threshold was wrong -- that still left a flat/clamped region,
        ; exactly what was rejected). The correct fix is the opposite
        ; direction: scale |BEND| DOWN by 0.625 (=40/64) before squaring,
        ; so the true knob extreme (|BEND|=1.0) feeds the formula exactly
        ; what 0.625 used to feed it (i.e. what display -40 used to give),
        ; and every value in between scales down proportionally -- smooth,
        ; monotonic, no clamp needed at all (0.625x can never exceed 1.0,
        ; so this can't overflow regardless of input). Only applied to
        ; this (shrink) branch -- grow/decelerate stays exactly as
        ; before, per the user's explicit request.
        move a1,x0 ; x0 = |BEND|
        move #>$500000,y0 ; 0.625 = 40/64
        mpy x0,y0,a ; a = |BEND|*0.625 -- cannot overflow
        ; Square before scaling -- user feedback (separate from the
        ; compression above): with a plain linear mapping, almost the
        ; entire usable shrink range collapsed into a small part of the
        ; knob's travel (compounding across many repeats makes a linear
        ; per-repeat delta feel sharply nonlinear overall). Squaring
        ; (x0,x0 -- EN's own confirmed-real parameter-squaring idiom, see
        ; GOLD_STANDARD section 2) spreads the gentle end out further.
        move a1,x0 ; x0 = |BEND| (compressed)
        mpy x0,x0,a ; a = |BEND|^2
        move a1,y0 ; y0 = |BEND|^2
        move #>HALF_Q23,x0
        mpy y0,x0,a ; true fraction * true fraction
        move a1,y0 ; y0 = |BEND|^2 * 0.5
        move y:(r6+$14),a
        move a1,x0 ; x0 = current gap (plain integer)
        mpy x0,y0,a ; plain integer * true fraction: a1
                                         ; lands correctly, no shift needed
        ; CRITICAL: must NOT use x1 as scratch here -- x1 holds this
        ; sample's dry signal, live across the WHOLE per-sample loop body
        ; until the final output mix reads it. Clobbering it here
        ; corrupted the dry output itself (not just wet) on any sample
        ; where a BEND restart happens -- reported on hardware as "fully
        ; dry gives some bounce delay." Use y1 instead, which is free here.
        move a1,y1 ; y1 = shrink delta
        move y:(r6+$14),a
        sub y1,a
        bra <BEND_CLAMP
BEND_GROW:
        move a1,y0 ; y0 = BEND (already >=0)
        move #>HALF_Q23,x0
        mpy y0,x0,a
        move a1,y0 ; y0 = BEND*0.5
        move y:(r6+$14),a
        move a1,x0
        mpy x0,y0,a
        move a1,y1 ; y1 = grow delta (NOT x1 -- see comment above)
        move y:(r6+$14),a
        add y1,a
BEND_CLAMP:
        move #>GAP_FLOOR,x0
        cmp x0,a
        bge <BEND_CLAMP_HI
        move x0,a
BEND_CLAMP_HI:
        move #>GAP_CEIL,x0
        cmp x0,a
        ble <BEND_CLAMPED
        move x0,a
BEND_CLAMPED:
        move a1,y:(r6+$14)
        move a1,y:(r6+$13)

        ; safety cap and decay-based stop, checked once per restart (not
        ; once per sample -- cheap).
        move y:(r6+$18),a
        add #>1,a
        move a1,y:(r6+$18)
        cmp #>MAXREPEATS,a
        bge <BOUNCE_STOP
        ; the restart that just fired bounce #1 (REPEATS_FIRED now ==1)
        ; is the pristine capture -- DCAY doesn't degrade anything until
        ; the SECOND pass (same reasoning as BOUNCE_ADVANCE_FIRST below).
        ; Found by naive review: without this exemption, DCAY at/near its
        ; minimum knob position multiplies ACCUM_LEVEL straight to (near)
        ; zero before bounce #1 ever streams, trips LEVEL_THRESHOLD, and
        ; silences the WHOLE train immediately -- contradicts the brief's
        ; "not silent after one bounce."
        cmp #>1,a
        beq <BOUNCE_BEGIN_PASS
        move y:(r6+$17),x0
        move n4,y0 ; cached DCAY_MULT (see the once-per-block caching
                   ; comment above)
        mpy x0,y0,a ; true fraction * true fraction
        move a1,y:(r6+$17)
        cmp #>LEVEL_THRESHOLD,a
        blt <BOUNCE_STOP
BOUNCE_BEGIN_PASS:

        ; begin a fresh pass through the captured buffer. decim ctr=0 (not
        ; DECIM_M1) so the first streamed sample of this new pass advances
        ; immediately instead of holding over the previous pass's stale
        ; value for up to DECIM_M1 samples.
        clr a
        move a,y:(r6+$11)
        move a,y:(r6+$12)
        move y:(r6+$10),a
        move a1,y1 ; y1 = CAP_LEN_FINAL (mpy needs an
                                         ; x0/x1/y0/y1 source, never a0/a1)
        move #>DECIM,x0
        mpy y1,x0,a ; plain int * plain int -- small
        asr a
        move a0,a ; relocate into a1
        move a1,y:(r6+$15)
        bra <GAP_KEEP
BOUNCE_STOP:
        clr a
        move a,y:(r6+$a) ; back to IDLE: train has run its course
        move a,y:(r6+$15)
GAP_KEEP:

        ; stream the active repeat, if any, one real sample at a time.
        ; Decimated-hold playback with LINEAR INTERPOLATION: a hard
        ; zero-order hold (repeat the same value for DECIM samples then
        ; jump) is a classic source of harsh aliasing, and makes every
        ; repeat-restart an instant jump to buffer[0] -- both reported as
        ; an unacceptable high-pitched artifact. Fix: HELD_WET is now a
        ; continuously-ramping value, nudged by INTERP_STEP every single
        ; sample (hold or advance alike) toward whatever target was set at
        ; the last advance -- so both ordinary decimation steps AND pass
        ; restarts glide smoothly over DECIM samples instead of jumping.
        move y:(r6+$15),a
        tst a
        ble <SKIP_BOUNCE
        sub #>1,a
        move a1,y:(r6+$15)
        move y:(r6+$1a),x0 ; INTERP_STEP
        move y:(r6+$19),a ; HELD_WET (current ramped value)
        add x0,a
        move a1,y:(r6+$19)
        move a1,b ; b = this sample's wet output
        move a1,n6 ; REAL BUG FIX (2026-11-07, hardware report: "harsh
                   ; aliasing noise", confirmed via probe_nfxbo.cpp's
                   ; Test 8 direct per-sample trace): stash the wet
                   ; output here too. BOUNCE_ADVANCE below (taken on
                   ; exactly 1-in-DECIM samples, the same periodic rate
                   ; as the "aliasing" report) reuses 'b' as its OWN
                   ; unpack scratch (BOUNCE_BOTTOM's own 4-step shift
                   ; dance in particular) and never restores it before
                   ; falling through to SKIP_BOUNCE's shared output
                   ; combine -- that combine reads b1 assuming it still
                   ; holds the value set here, but on an advance sample
                   ; it actually holds unrelated leftover state from the
                   ; unpack, corrupting exactly 1 sample in 4 with
                   ; uncorrelated garbage. A corrupted sample recurring
                   ; at a fixed DECIM-periodic rate is textbook
                   ; aliasing (a tone at Fs/DECIM and its harmonics),
                   ; exactly matching the report. Restored from n6
                   ; (confirmed genuinely free scratch, see the NBAL/
                   ; MIX caching comment above) right before SKIP_BOUNCE.
        move y:(r6+$12),a
        tst a
        ble <BOUNCE_ADVANCE
        sub #>1,a
        move a1,y:(r6+$12)
        bra <SKIP_BOUNCE
BOUNCE_ADVANCE:
        move #>DECIM_M1,a
        move a1,y:(r6+$12)

        ; --- 12-bit packing: word-index = BOUNCE_POS>>1, sub_phase =
        ; BOUNCE_POS&1. Unlike CAP_STORE above (which only ever writes a
        ; COMPLETE word once, after both halves of a pair are ready),
        ; this reads AND writes the SAME word every single decimated
        ; step, compounding decay in place -- there is no "wait for the
        ; pair" here, just a plain read-modify-write that must preserve
        ; whichever half it isn't updating. sub_phase branches ONCE here
        ; into two full duplicated paths (TOP/BOTTOM) instead of
        ; branching once for unpack and AGAIN for pack/preserve --
        ; measured directly (on this exact backport's first attempt) that
        ; removing a SECOND branch this way was worth real cycles on this
        ; emulator, more than the handful of small instructions
        ; duplicated to get there (an earlier attempt at eliminating a
        ; redundant Y-memory READ instead of a redundant BRANCH showed NO
        ; measurable improvement -- branches, not memory reads, appear to
        ; be the actual cost driver on this up-to-8x/block path). ---
        move y:(r6+$11),a ; BOUNCE_POS
        asr #1,a,a ; word-index = BOUNCE_POS>>1 (single shift, safe)
        move a1,n3

        move y:(r6+$11),a
        and #>1,a ; sub_phase = BOUNCE_POS&1 -- and's own flags survive
                  ; a plain move (and_flags_direct_test.asm56k), no tst
                  ; needed
        bne <BOUNCE_BOTTOM

; ===== TOP half path (sub_phase=0) =====
        move y:(r3+n3),b
        move b1,n5 ; stash the ORIGINAL word (hardware-risk hardening,
                   ; same reasoning as NFX-BO's own first attempt --
                   ; avoids reading this exact indexed address TWICE
                   ; before writing it a third time, a pattern never
                   ; exercised anywhere else in this project's own
                   ; hardware-proven history) before the unpack below
                   ; destroys b
        asr #12,b,b
        move b1,a
        asl #12,a,a ; a1 = raw, Q23-ish, top half
        move a1,x0 ; x0 = raw (unpacked)

        move y:(r6+$18),a ; REPEATS_FIRED
        cmp #>1,a
        beq <BOUNCE_ADVANCE_FIRST ; shared -- sub_phase doesn't matter
                                  ; for the no-write first-pass case

        move n4,y0 ; cached DCAY_MULT
        mpy x0,y0,a ; a = processed = raw * DCAY_MULT (new target)
        ; CRITICAL: must NOT use x1 here either -- same reason as the BEND
        ; restart code above (x1 holds this sample's dry signal, live
        ; until the final output mix). Use y1 instead.
        move a1,y1 ; y1 = processed (new target, full precision -- used
                   ; for the interpolator below)

        ; REAL BUG, found 2026-11-07 via a hardware report ("works but
        ; extremely noisy, basically just one giant noise burst" / "whatever
        ; is sampled is crunched into harsh noise"). The investigation went
        ; through two dead ends before landing on the real cause, both worth
        ; recording so they aren't re-walked:
        ;   1. A "decay gets permanently stuck at a nonzero value" symptom
        ;      looked like the same-register-double-shift hazard (see the
        ;      header comment at the top of this file), but the probe that
        ;      showed it had its OWN bug (GAP_REMAIN never re-armed between
        ;      iterations, causing an unintended internal restart) -- once
        ;      fixed, the original code decayed cleanly to exactly 0. Ruled
        ;      out; nothing wrong here under single-half repeated decay.
        ;   2. A capture/bounce word-sharing RACE (12-bit packing means two
        ;      logical positions share one physical word, unlike NFX-BO's
        ;      24-bit original) looked plausible given GATE=0+fastest-RATE
        ;      symptoms, but a direct test with capture fully disabled
        ;      (CAP_REMAIN=0) reproduced the exact same corruption. Ruled out.
        ; The REAL cause: alternating TOP/BOTTOM visits to the SAME word
        ; (exactly what happens as BOUNCE_POS walks forward, or revisits
        ; early words after a fast restart) corrupts the PRESERVED other
        ; half. "asr #12,a,a" (quantize) followed by "asl #12,a,a"
        ; (reposition into the top 12-bit slot) on the SAME register, with
        ; only "and #>$fff,a" (NOT a full reload) between them, leaks
        ; residual accumulator-extension state into the positioned value's
        ; own low 12 bits -- confirmed via direct instrumentation (expected
        ; a clean value with zeros below bit 12, got nonzero garbage there
        ; instead). Harmless in isolation (a lone TOP-only repeated-decay
        ; test never surfaces it, since the next unpack re-shifts those
        ; stray bits away before they're ever read) -- but once
        ; BOUNCE_COMBINE ORs this "positioned" value against the PRESERVED
        ; other half, the leaked bits silently corrupt it, compounding
        ; worse with every further visit (confirmed via
        ; dsp56300/cyclecheck/probe_nfxbo.cpp's Test 7, a direct alternating-
        ; visit injection with capture fully inert). Fixed the same way the
        ; header comment's own hazard writeup prescribes: force a full
        ; reload through 'b' (which correctly re-establishes clean sign-
        ; extension) before the second shift.
        asr #12,a,a ; quantize (single shift, safe)
        and #>$fff,a
        move a1,b ; force a full reload (see writeup above) before the asl
        move b1,a
        asl #12,a,a
        move a1,x0 ; x0 = positioned value (top slot)

        move n5,a ; a = stashed original word
        and #>$fff,a ; preserve BOTTOM bits (we updated TOP)
        bra <BOUNCE_COMBINE

; ===== BOTTOM half path (sub_phase=1) =====
BOUNCE_BOTTOM:
        move y:(r3+n3),b
        move b1,n5 ; stash the ORIGINAL word -- see the TOP path's
                   ; comment above this same line
        asl #12,b,b
        move b1,a
        asr #12,a,a
        move a1,b
        asl #12,b,b
        move b1,a ; a1 = raw, Q23-ish, bottom half
        move a1,x0 ; x0 = raw (unpacked)

        move y:(r6+$18),a ; REPEATS_FIRED
        cmp #>1,a
        beq <BOUNCE_ADVANCE_FIRST

        move n4,y0 ; cached DCAY_MULT
        mpy x0,y0,a
        move a1,y1 ; y1 = processed (new target)

        asr #12,a,a ; quantize
        and #>$fff,a
        move a1,x0 ; x0 = positioned value (bottom slot, no shift needed)

        move n5,a ; a = stashed original word (see TOP path's comment)
        and #>$fff000,a ; preserve TOP bits (we updated BOTTOM)
BOUNCE_COMBINE:
        ; deliberately routes the mask through 'a' (using y0 as a
        ; temporary holding register, free here -- DCAY_MULT already
        ; consumed by the mpy above) rather than operating on
        ; accumulator b -- the only proven-safe operations on b in this
        ; file are plain moves and shifts (the unpack above), not
        ; and/add, so this avoids an unverified instruction-operand
        ; combination.
        move a1,y0 ; y0 = preserved other-half bits
        move x0,a ; a = our positioned value
        add y0,a ; combine (the two positioned/preserved halves never
                 ; overlap in bits, so this is equivalent to an OR)
        move a1,y:(r3+n3) ; write back the complete word (compounds)
        bra <BOUNCE_ADVANCE_DONE
BOUNCE_ADVANCE_FIRST:
        ; the first pass through the buffer (REPEATS_FIRED==1) is the
        ; pristine capture -- DCAY only starts compounding from the
        ; second pass onward (per the brief), so leave the buffer
        ; untouched and feed the raw (unpacked) sample straight to the
        ; interpolator. No write at all in this branch, same as before
        ; 12-bit packing.
        move x0,a
        move a1,y1 ; y1 = raw (unprocessed)
BOUNCE_ADVANCE_DONE:
        ; CRITICAL (found 2026-11-03, real bug, confirmed against the user's
        ; own hardware recordings): this used to compute step as
        ; (target>>4) - (current>>4), shifting EACH operand down by 4 bits
        ; BEFORE subtracting -- reasoning at the time was "a few LSBs less
        ; precise, irrelevant at this interpolation granularity." That
        ; reasoning only holds for a LOUD signal. For a QUIET one -- and
        ; every repeat's tail, or any quiet passage, is exactly that --
        ; most of the signal's actual information lives in precisely the
        ; low 4 bits this throws away independently from each operand
        ; (e.g. a signal at ~0.00012 of full scale is only ~1000 raw Q23
        ; units; discarding up to 15 units from EACH of two operands before
        ; combining is a multi-percent error on a value that small, not a
        ; "few LSBs"). The result was a persistent, roughly fixed-magnitude
        ; staircase artifact riding on top of the real (decaying) signal --
        ; audible as a steady high-pitched ring/tone (confirmed via
        ; spectrogram + direct time-aligned amplitude analysis of real
        ; recordings: artifact-to-signal ratio was ~0.02-0.07 in quiet
        ; passages vs ~0.0002-0.002 in loud ones, while the artifact's own
        ; ABSOLUTE size barely changed between them -- the signature of a
        ; fixed quantization floor, not content-dependent aliasing, which
        ; is exactly why ALFC (a pre-capture filter) had zero effect on it
        ; no matter how it was set).
        ;
        ; Fixed using the SAME already-proven-safe pattern used elsewhere
        ; in this file (the anti-alias filter, the HPF) for exactly this
        ; "subtract two independently-bounded values without overflowing"
        ; problem: subtract in the FULL accumulator first (captures the
        ; true difference even past +/-1.0, so it cannot overflow), THEN
        ; shift the result down ONCE at the end -- one truncation instead
        ; of two, done on the full-precision difference instead of on each
        ; operand independently, so quiet signals keep their precision.
        move y1,a ; a = target (full accumulator)
        move y:(r6+$19),x0 ; x0 = HELD_WET (current)
        sub x0,a ; a = target - current, full accumulator -- exact even
                 ; past +/-1.0, same proof as the HPF/anti-alias subtracts
        ; shift amount MUST track DECIM_SHIFT (=log2(DECIM)) -- the ramp
        ; has to reach the new target in exactly DECIM hold-samples. This
        ; immediate was briefly fed by a register-sourced SHIFT_EXP_CUR
        ; during the short-lived live-DECIM-knob round and never got
        ; updated to match it at this exact site -- any DECIM above 8
        ; made the step several times too large, so HELD_WET overshot
        ; its target every sample and never settled (the "portal to
        ; hell" reported for high knob values). Back to a plain
        ; compile-time immediate now that DECIM is fixed per build --
        ; if you edit DECIM above, you MUST update DECIM_SHIFT (and this
        ; instruction) to match, by hand.
        asr #DECIM_SHIFT,a,a ; a = (target-current)/DECIM, single
                             ; truncation, from the full-precision
                             ; difference
        move a1,y:(r6+$1a) ; new INTERP_STEP, ramps toward target over the
                           ; next DECIM_M1 hold-samples
        move y:(r6+$11),a
        add #>1,a
        move y:(r6+$10),x0
        cmp x0,a
        blt <BOUNCE_NOWRAP
        clr a
BOUNCE_NOWRAP:
        move a1,y:(r6+$11)
        move n6,b ; restore the wet output stashed above -- see the
                  ; REAL BUG FIX comment at the top of this function
SKIP_BOUNCE:

        ; --- output: dry*(1-MIX) + wet*MIX --- (MIX/1-MIX cached once
        ; per block above, in r1/r4 -- not recomputed per sample)
        move r1,y0 ; y0 = cached 1-MIX
        mpy x1,y0,a ; dry(x1) * (1-MIX)(y0) -- x1 is
                                         ; already a valid mpy source, no
                                         ; need to round-trip through a1
        move r4,y0 ; y0 = cached MIX
        move b1,x0 ; x0 = wet sample
        macr x0,y0,a ; a = dry*(1-MIX) + wet*MIX, rounded
        move a,y:(r7)+
RENDER_END:
        rts

