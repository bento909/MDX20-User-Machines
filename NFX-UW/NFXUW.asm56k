; NFX-UW v1 -- self-sampling overdub/freeze machine. Built from NFX-BO's
; patterns (same INIT/TRIG idiom, same RVRS mechanism, same convex-
; combination and clamp-sum safety patterns) but architecturally
; different: no RATE/BEND/DCAY, no decaying bounce train. Every trig
; runs a SINGLE unified pass through its own capture buffer: read each
; position's existing content (that becomes this sample's output),
; optionally blend it with a fresh live capture and write the blend
; back, then advance -- sound-on-sound overdub, not record-then-play.
; See BRIEF.md / DESIGN.md for the full spec and reasoning.
;
; Parameter block (Y, relative to r6):
;   Y+1 NBAL  unipolar_q23  neighbour blend: 0=two back(far) 1=one back(near)
;   Y+2 GATE  bipolar_q23   capture-window shaping, 0=full window
;   Y+3 REC   unipolar_q23  0=pure fresh capture (old content ignored).
;                           1..~126=old content folded back at a REC-
;                           scaled level, summed with a full-level fresh
;                           capture, clamped. ~127 (knob=127 raw value)
;                           disables writing entirely -- pure replay;
;                           the live neighbour blend only reaches the
;                           OUTPUT via MIX's dry side, never the buffer.
;   Y+4 RVRS  bipolar_q23   reverse-capture probability -- IDENTICAL
;                           mechanism to NFX-BO's own RVRS (see that
;                           file's header for the full derivation):
;                           $800000=ALWAYS reverse, >=$7e0000=NEVER,
;                           else p_reverse=(1-RVRS)/2 vs a 24-bit
;                           Galois LFSR draw. Only drawn on trigs where
;                           capture actually runs (REC<~127).
;   Y+5 MIX   unipolar_q23  dry/wet on the OUTPUT only -- never affects
;                           what's written to the buffer (capture reads
;                           the pre-mix dry signal, same as NFX-BO).
;   Y+6 START unipolar_q23  (displayed as "STRT" -- MDS param names are
;                           capped at 4 characters, same reason NFX-BO's
;                           DECIM became DECM) playback loop region's
;                           start, as a fraction of LOGICAL_BUFLEN.
;   Y+7 LOOP_LEN unipolar_q23  (displayed as "LOOP") playback loop
;                           region's length, as a fraction of
;                           LOGICAL_BUFLEN (floored to a minimum of 1
;                           logical position). Classic sampler loop-point
;                           semantics: the read head wraps within
;                           [START, START+LOOP_LEN) -- circularly past
;                           the buffer's own physical end if needed --
;                           for as long as the trig's fixed
;                           WINDOW_SAMPLES duration lasts. Max value =
;                           the loop region spans the rest of the
;                           window, so it only plays once (no time left
;                           to wrap back). Small values wrap many times
;                           within the same fixed duration.
;
; Y+8 JITR  unipolar_q23  random per-trig jitter applied to STRT's own
;                           LOOP_START position (2026-11-04, filling the
;                           slot SPED left behind -- see below). Draws a
;                           fresh value from the same Galois LFSR RVRS
;                           already uses, reused directly as a BIPOLAR
;                           Q23 fraction (no masking -- unlike RVRS's
;                           own draw, which explicitly masks out the
;                           sign bit for a unipolar probability). 0
;                           (default) gives exactly zero offset --
;                           identical to the pre-JITR behavior. Scaled
;                           by LOGICAL_BUFLEN (same reference START
;                           itself uses), so at max JITR could in
;                           principle jitter the start point almost
;                           anywhere in the buffer -- a deliberately
;                           dramatic range for an experimental
;                           freeze/overdub instrument, not a subtle one.
;                           Wrapped into [0,LOGICAL_BUFLEN) afterward via
;                           an explicit compare+add/sub (NOT a bitmask --
;                           LOGICAL_BUFLEN=3072 isn't a power of 2).
;
; SPED (round 3's variable-speed/reverse playback knob) was REMOVED
; 2026-11-04, direct user request, after a real hardware report ("the
; speed parameter just makes it sound like hell" / "at 0 speed nothing
; happens"). The root cause was found and fixed first (RAMP_FRACTION's
; derivation had a genuine 2x calibration error, compounded by not
; tracking the clamped STEP_SIZE -- see project memory / git history if
; this is ever revisited), but rather than ship that fix and re-test,
; the user asked to pull the knob out entirely for now ("we might
; revisit"). START/LOOP_LEN moved down from Y+7/Y+8 to Y+6/Y+7 to fill
; the gap, and JITR (above) now fills the remaining trailing slot.
; PLAYBACK itself is unchanged in kind -- still a read head fully
; decoupled from capture, still respecting START/LOOP_LEN's own loop
; region -- it just always scrubs FORWARD now, at the exact rate this
; machine always used before round 3 ever added a speed knob -- a
; plain decimated advance (PB_DECIM_CTR, see the Y+25 header comment),
; not a variable-rate fixed-point accumulator anymore, since there is
; no more knob to make that generality worth its cost.
;
; REAL BUG found and fixed while designing JITR (2026-11-04), independent
; of jitter itself: PLAYBACK's read head never wrapped its own position
; back into the PHYSICAL buffer range when the loop region (as this
; design always claimed) extends past the buffer's own end -- it could
; read/write OUTSIDE this track's TRACK_BUFFERS region. A static,
; user-chosen STRT rarely landed there; JITR's own random walk makes it
; far more likely, which is what surfaced this during design rather
; than after shipping. See PLAYBACK's own PB_ADDR_OK comment for the fix.
;
; 12-bit sample packing: two signed 12-bit samples share one 24-bit
; Y-memory word, doubling effective buffer capacity (LOGICAL_BUFLEN =
; BUFLEN*2 = 3072 logical positions) independent of DECIM. A logical
; sample index replaces a plain word index; word-index = logical>>1,
; sub-phase = logical&1 (0=top 12 bits, 1=bottom 12). Quantize via
; asr #12 (top 12 bits, already sign-extended); pack two quantized
; halves by masking each to #$fff and shifting the first left 12 before
; adding; unpack a half by shifting to reposition (bottom half only)
; then sign-extending (asr #12) then rescaling back to Q23 range
; (asl #12, bottom 12 bits now zero -- the quantization noise floor,
; SP-1200/S900-style character).
;
; CRITICAL, confirmed via direct probe (dsp56300/cyclecheck/sign_test/
; shift12_isolate*.asm56k, pack12_test2.asm56k) BEFORE relying on it:
; two consecutive immediate-shift instructions naming the SAME register
; silently merge into one NET shift (asr counts negative, asl positive)
; regardless of what unrelated instructions sit between them -- "asr
; #12,a,a" then "asl #12,a,a" nets to a complete no-op, not two
; independent shifts. Only a genuine WRITE to that register from
; elsewhere breaks the merge. Fix, used throughout below: alternate
; registers for every such pair (shift on b, move b1,a, shift on a) --
; never two shifts in a row naming the same register. Same-direction
; chains (two asr's, two asl's) compound correctly and don't need this.
;
; Persistent state (Y, relative to r6; all free words past the 7 params,
; Y+8 itself also free -- see the Y+6/Y+7 header comments above):
;   Y+9  TRACKMEM_BASE   this track's TRACK_BUFFERS base word address
;   Y+10 PHASE           0=IDLE 1=ACTIVE (a pass is running)
;   Y+11 TRIG_FLAG       set by TRIG, consumed once by RENDER
;   Y+12 LOGICAL_POS     current logical sample index, drives BOTH the
;                        read (output) and the write (capture) side of
;                        the unified pass -- there is only one position,
;                        not separate capture/bounce heads like NFX-BO,
;                        since here they are the same pass.
;   Y+13 CAP_REMAIN      logical samples left for which writing is still
;                        allowed this trig (GATE-derived countdown).
;                        Reading/output is NEVER gated by this -- only
;                        writing is. Irrelevant (not decremented) when
;                        CAPTURE_ENABLED=0.
;   Y+14 DECIM_CTR       real-sample countdown between decimated steps
;   Y+15 CAP_DELAY_REMAIN real samples to wait before writing starts
;                        (GATE>0 case, delays the WRITE only, not reading)
;   Y+16 WINDOW_REMAIN   real samples left in the fixed-duration pass
;                        (LOGICAL_BUFLEN*DECIM long, always the full
;                        fixed duration regardless of GATE -- same
;                        "GATE shapes WHAT, never WHEN" principle as
;                        NFX-BO). Reaching zero ends the pass (PHASE
;                        goes back to IDLE).
;   Y+17 REVERSE_FLAG    this trig's pass direction (0=forward from
;                        logical 0 upward, 1=reverse from
;                        LOGICAL_BUFLEN-1 downward). Controls BOTH read
;                        and write together -- they are the same pass,
;                        unlike NFX-BO where capture's write-direction
;                        and bounce's read-direction are independent.
;   Y+18 RNG_STATE       24-bit Galois LFSR state, same mechanism as
;                        NFX-BO's RVRS. Seeded nonzero in INIT, never
;                        reset (a zero seed is this LFSR's fixed point).
;   Y+19 PENDING_HALF    on a phase-0 write event, the quantized half is
;                        stashed here (not written to memory yet); on
;                        the matching phase-1 event, it's packed with
;                        that event's own half and the complete word is
;                        written in one go -- avoids any read-modify-
;                        write on a half-complete word.
;   Y+20 HELD_WET        continuously-ramping interpolated output,
;                        nudged by INTERP_STEP every sample (same
;                        decimated-hold-with-interpolation approach as
;                        NFX-BO -- a hard jump every DECIM samples is
;                        audibly harsh, this smooths it).
;   Y+21 INTERP_STEP     per-sample increment ramping HELD_WET toward
;                        the latest target over DECIM samples
;   Y+22 CAPTURE_ENABLED 0/1, latched once per trig from REC's raw value
;   Y+23 REC_SCALE       Q23 fraction scaling old content's contribution
;                        to the write-back blend, latched once per trig
;   Y+24 PB_POS           PLAYBACK's own read position, in plain LOGICAL
;                        units (NOT fixed-point -- see the note below on
;                        why this no longer needs to be). Independent of
;                        LOGICAL_POS (the write head). Always kept
;                        wrapped within [LOOP_START, LOOP_END).
;   Y+25 PB_DECIM_CTR     real-sample countdown before PB_POS advances --
;                        exactly the same shape as capture's own
;                        DECIM_CTR (Y+14), just a separate counter for
;                        the independent read head. REDESIGNED
;                        2026-11-04 along with SPED's removal: round 3
;                        originally gave PLAYBACK a fixed-point Q(12.8)
;                        phase accumulator (READ_PHASE) plus a
;                        variable signed STEP_SIZE, because SPED let the
;                        rate vary continuously. With SPED gone, the
;                        rate is now ALWAYS exactly DECIM's own cadence
;                        (one position per DECIM real samples, forward
;                        only) -- the general fixed-point machinery was
;                        pure overhead for a rate that never actually
;                        varies, and measured as a real, avoidable cost
;                        on the 3-out-of-4 samples that never cross a
;                        position boundary. A plain decimated-advance
;                        counter (identical in spirit to capture's own)
;                        is both simpler AND cheaper.
;   Y+26 unused -- held RAMP_FRACTION (Q23 ramp-speed fraction) before
;                        this redesign; now a true compile-time constant
;                        (RAMP_FRACTION_FIXED) needed only transiently at
;                        the infrequent retarget site, not latched here.
;   Y+27 LOOP_START       plain-integer loop-region start (logical
;                        units), latched once per trig (= STRT_raw *
;                        LOGICAL_BUFLEN -- same mpy semantics GATE
;                        already uses for its own analogous derivation,
;                        no Q8 scaling needed anymore either).
;   Y+28 LOOP_LEN         plain-integer loop-region length, latched once
;                        per trig, floored to a minimum of 1 logical
;                        position. Kept for reference only -- PLAYBACK
;                        itself reads LOOP_END (Y+29) instead, below.
;   Y+29 LOOP_END         = LOOP_START + LOOP_LEN, latched once per trig.
;                        Cached into n5 for the whole block (see
;                        RENDER_LOOP's once-per-block caching) alongside
;                        LOOP_START (n4). Because PB_POS only ever
;                        advances by exactly +1 and is always kept
;                        in-range beforehand, wrapping needs no
;                        subtraction at all -- "if PB_POS>=LOOP_END,
;                        set PB_POS=LOOP_START" is exact (the old
;                        fixed-point version needed a general
;                        phase-END+START correction because a variable
;                        STEP_SIZE could overshoot by an arbitrary
;                        amount; a fixed +1 step never can).
;   Y+30 unused -- held LAST_READ_POS (a sentinel used to detect a
;                        phase crossing) before this redesign; no longer
;                        needed since PB_DECIM_CTR's own countdown
;                        reaching zero IS the crossing signal now, with
;                        nothing to compare against.
;
; Fixed-point notes carried forward from NFX-BO (empirically verified,
; not assumed -- see that file's own header and refs/GOLD_STANDARD.md):
;   - mpy of a TRUE Q23 fraction times a PLAIN INTEGER lands correctly
;     in a1 directly, no extra shift needed.
;   - mpy of two PLAIN INTEGERS (small, no fractional intent) needs
;     "asr a" then "move a0,a" to undo the doubled-product convention.
;   - mpy's source operands must be x0/x1/y0/y1 -- never a0/a1/b0/b1.


.equ BUFLEN 1536 ; TRACK_BUFFERS words/track (hardware allocation)
.equ LOGICAL_BUFLEN 3072 ; = BUFLEN*2, two 12-bit samples/word
.equ DECIM 4 ; real samples skipped per stored logical sample. Same
             ; default as NFX-BO; MUST keep DECIM_SHIFT below in sync by
             ; hand (no log2() in this project's assembler).
.equ DECIM_SHIFT 2 ; = log2(DECIM)
.equ DECIM_M1 3 ; = DECIM-1
.equ WINDOW_SAMPLES 12288 ; = LOGICAL_BUFLEN*DECIM (~278ms at DECIM=4 --
                          ; double NFX-BO's ~139ms at the same DECIM,
                          ; the whole point of 12-bit packing)
.equ GAP_FLOOR 8 ; unused here (no bounce-restart concept) -- kept only
                 ; if a future round adds one; harmless if never read.
.equ LEVEL_THRESHOLD $000800 ; unused here, same reason as GAP_FLOOR
.equ FEEDBACK_GATE $001000 ; feedback-loop breaker (2026-11-04, user
                 ; report: runaway buildup, especially on reverse).
                 ; REC's overdub is a closed feedback loop with no
                 ; forced decay (unlike NFX-BO's DCAY) -- near-silent
                 ; residue, and the 12-bit quantization's own rounding
                 ; bias (asr rounds toward -inf for negative values,
                 ; toward 0 for positive ones -- NOT symmetric), can
                 ; otherwise recirculate and slowly compound forever.
                 ; Below this magnitude, the OLD content's scaled
                 ; contribution is forced to exact zero before being
                 ; added to the fresh capture, breaking the cycle.
                 ; Provisional value (~-66dB) -- revisit by ear.
.equ FEEDBACK_GATE_NEG $fff000 ; = -FEEDBACK_GATE (two's complement)
.equ LOOP_LEN_MIN 1 ; one whole logical position -- the loop region can
                 ; never collapse to zero width.
.equ RAMP_FRACTION_FIXED $200000 ; Q23, = 0.25 = 1/DECIM. The fraction
                 ; of the target-current gap PLAYBACK's interpolator
                 ; adds every sample so HELD_WET's ramp lands exactly
                 ; on target after DECIM samples -- the same role (and
                 ; the same value) this machine's interpolation has
                 ; always used, now reached via PB_DECIM_CTR's plain
                 ; decimated-advance instead of a fixed-point phase
                 ; accumulator (see the Y+24/Y+25 header comments for
                 ; why that redesign happened). Needed only transiently
                 ; at the (infrequent, DECIM-gated) retarget site, not
                 ; latched to Y-memory at all anymore.


INIT:
        ; TRACKMEM base = r1 * 1536, rounded up to the next 512-word
        ; boundary. Identical pattern to NFX-BO/NFX-EN's own confirmed-
        ; working INIT -- see refs/GOLD_STANDARD.md section 3.
        move r1,y0 ; r1 = this track's number (0-15)
        move #>BUFLEN,x0
        mpy y0,x0,a ; confirmed-correct pairing (never mpy y0,y1,a --
                    ; that silently returns zero on this hardware)
        asr a
        move a0,a
        move a1,y1
TRACKMEM:
        move #>$0,x0 ; placeholder, patched by the loader to track 0's
                     ; TRACK_BUFFERS base (kind-2 import, symbol 6)
        move y1,a
        add x0,a
        move a1,r0
        move r0,y:(r6+$9)

        ; clear this track's whole TRACK_BUFFERS region (spec: "clear
        ; it before reading" -- it may hold another machine's data).
        ; All-zero packs to all-zero either way, so a freshly-cleared
        ; buffer reads back as silence everywhere until first written --
        ; no separate "valid length" tracking needed.
        move #>$ffffff,m0
        clr a
        rep #BUFLEN
        move a,y:(r0)+

        clr a
        move a,y:(r6+$a)
        move a,y:(r6+$b)
        move a,y:(r6+$c)
        move a,y:(r6+$d)
        move a,y:(r6+$e)
        move a,y:(r6+$f)
        move a,y:(r6+$10)
        move a,y:(r6+$11)
        move a,y:(r6+$13)
        move a,y:(r6+$14)
        move a,y:(r6+$15)
        move a,y:(r6+$16)
        move a,y:(r6+$17)
        move a,y:(r6+$18)
        move a,y:(r6+$19)
        move a,y:(r6+$1a)
        move a,y:(r6+$1b)
        move a,y:(r6+$1c)
        move a,y:(r6+$1d)
        ; Y+30/$1e is genuinely unused (used to hold LAST_READ_POS,
        ; before round 3's playback redesign removed the need for a
        ; crossing-detection sentinel entirely) -- left uncleared here,
        ; harmless since nothing ever reads it.
        ; RNG_STATE (Y+18/$12) must NOT be zero -- a Galois LFSR seeded
        ; at 0 is a fixed point (lsl(0)=0, carry always 0, eor never
        ; fires: it would stay 0 forever). Same precedent as NFX-BO's
        ; own INIT and pluck.asm56k's own comment ("any nonzero noise
        ; state").
        move #>$5a5a5a,x0
        move x0,y:(r6+$12)
        rts

TRIG:
        move #>$1,x0
        move x0,y:(r6+$b)
        rts

RENDER:
        ; --- once per block: consume a fresh trig, if any ---
        move y:(r6+$b),a
        tst a
        beq <RENDER_NOTRIG
        clr a
        move a,y:(r6+$b)

        ; --- REC: decide CAPTURE_ENABLED and REC_SCALE once per trig ---
        ; REC is unipolar_q23. Firmware's knob=127 encoding (knob<<16)
        ; falls short of Q23's true $7fffff ceiling (same shortfall
        ; MIX/NFX-BO already works around) -- snap at that threshold so
        ; "127 disables capture" is exact, not merely "almost always".
        move y:(r6+$3),x0 ; REC, raw unipolar_q23
        move x0,a
        cmp #>$7f0000,a
        bge <REC_DISABLE
        move #>1,a
        move a1,y:(r6+$16) ; CAPTURE_ENABLED=1
        move x0,a
        move a1,y:(r6+$17) ; REC_SCALE = REC's own raw fraction directly
        bra <REC_DONE
REC_DISABLE:
        clr a
        move a1,y:(r6+$16) ; CAPTURE_ENABLED=0
        move a1,y:(r6+$17) ; REC_SCALE=0 (unused when disabled, but
                           ; keep it well-defined)
REC_DONE:

        ; --- RVRS: decide REVERSE_FLAG, same mechanism as NFX-BO ---
        ; (see NFXBO.asm56k's own header for the full derivation notes;
        ; reused verbatim here, only the destination offsets differ).
        ; When capture is disabled this trig, direction is irrelevant
        ; for WRITING (nothing gets written), but the unified pass still
        ; needs a direction for READING -- default to forward (0) in
        ; that case, matching "reading always reflects however the
        ; buffer was last actually written", not a fresh random choice
        ; with nothing to apply it to.
        move y:(r6+$16),a ; CAPTURE_ENABLED
        tst a
        bne <RVRS_DRAW_GATE
        clr a
        move a1,y:(r6+$11) ; REVERSE_FLAG=0 (forward) -- capture disabled
        bra <RVRS_DONE
RVRS_DRAW_GATE:
        move y:(r6+$4),x0 ; RVRS param, raw bipolar_q23
        move x0,a
        cmp #>$800000,a
        beq <RVRS_ALWAYS
        cmp #>$7e0000,a ; bipolar_q23's own knob=127 raw value is
                        ; $7e0000 ((knob-64)<<17), NOT $7f0000 (that's
                        ; unipolar's different shortfall)
        bge <RVRS_NEVER

        move #>$7fffff,a
        sub x0,a ; a = 1-RVRS, full accumulator, up to 2.0 -- not yet
                 ; truncated, cannot overflow
        asr a ; a = (1-RVRS)/2, now safely in [0,1]
        move a1,y0 ; y0 = p_reverse, stashed across the LFSR mix below
        bra <RVRS_DRAW
RVRS_ALWAYS:
        move #>1,a
        move a1,y:(r6+$11)
        bra <RVRS_DONE
RVRS_NEVER:
        clr a
        move a1,y:(r6+$11)
        bra <RVRS_DONE
RVRS_DRAW:
        ; 24-bit Galois LFSR (taps x^24+x^23+x^22+x^17+1, $c20001 --
        ; MDS's own pluck.asm56k example's noise generator idiom).
        ; Unrolled by hand, NOT wrapped in a hardware "do" loop -- the
        ; latter measured ~4600 EXTRA cycles on this toolchain/emulator
        ; in NFX-BO's own round-12 work despite looking obviously
        ; correct (see that file's RVRS_DRAW comment for the full story).
        move y:(r6+$12),b ; RNG_STATE
        move #>$c20001,x1
        lsl b
        bcc <RVRS_MIX1_KEEP
        eor x1,b
RVRS_MIX1_KEEP:
        lsl b
        bcc <RVRS_MIX2_KEEP
        eor x1,b
RVRS_MIX2_KEEP:
        lsl b
        bcc <RVRS_MIX3_KEEP
        eor x1,b
RVRS_MIX3_KEEP:
        lsl b
        bcc <RVRS_MIX4_KEEP
        eor x1,b
RVRS_MIX4_KEEP:
        lsl b
        bcc <RVRS_MIX5_KEEP
        eor x1,b
RVRS_MIX5_KEEP:
        lsl b
        bcc <RVRS_MIX6_KEEP
        eor x1,b
RVRS_MIX6_KEEP:
        lsl b
        bcc <RVRS_MIX7_KEEP
        eor x1,b
RVRS_MIX7_KEEP:
        lsl b
        bcc <RVRS_MIX8_KEEP
        eor x1,b
RVRS_MIX8_KEEP:
        move b1,y:(r6+$12) ; store the advanced RNG_STATE
        move b1,a
        and #>$7fffff,a ; fold into a unipolar fraction in [0,~1)
        move a1,x0 ; x0 = rng_fraction
        move y0,a ; a = p_reverse (stashed above)
        cmp x0,a
        bgt <RVRS_FLAG_SET
        clr a
        move a1,y:(r6+$11)
        bra <RVRS_DONE
RVRS_FLAG_SET:
        move #>1,a
        move a1,y:(r6+$11)
RVRS_DONE:

        ; --- STRT/LOOP -> LOOP_START/LOOP_LEN/LOOP_END (plain LOGICAL
        ; units now, not Q8 fixed-point -- see the Y+24/Y+25 header
        ; comments for why: SPED, round 3's variable-speed/reverse
        ; playback knob, was REMOVED 2026-11-04 (direct user request,
        ; after a real hardware report, "the speed parameter just makes
        ; it sound like hell" -- the root cause, a genuine calibration
        ; bug, was found and fixed first, but the user asked to pull the
        ; knob out entirely rather than ship-and-retest: "we might
        ; revisit"). With no more variable rate to support, PLAYBACK's
        ; position no longer needs fixed-point precision at all -- it
        ; only ever advances by a clean +1, gated by PB_DECIM_CTR, same
        ; shape as capture's own DECIM_CTR. A single mpy against
        ; LOGICAL_BUFLEN does the *LOGICAL_BUFLEN conversion directly
        ; (same "fraction * plain integer lands correctly in a1, no
        ; shift needed" mpy semantics GATE's own analogous derivation
        ; already relies on). STRT/LOOP moved down to Y+6/Y+7 (were
        ; Y+7/Y+8) when SPED's slot was removed -- Y+8 is now the
        ; trailing unused slot, same convention as NFX-BO's own freed
        ; ALFC slot.
        move y:(r6+$6),y0 ; STRT, raw unipolar_q23
        move #>LOGICAL_BUFLEN,x0
        mpy y0,x0,a
        move a1,y:(r6+$1b) ; LOOP_START

        ; --- JITR: random per-trig offset applied to LOOP_START (8th
        ; param, 2026-11-04, filling the slot SPED's removal freed --
        ; see the Y+8 header comment). Draws a FRESH value from the
        ; same shared RNG_STATE word RVRS uses above (advanced by its
        ; own, now-unconditional, 2-step mix -- see below), reused
        ; directly as a bipolar Q23 fraction. This is a second,
        ; independent draw/advance on the same persistent state, not a
        ; reuse of RVRS's own draw, since that one only runs
        ; conditionally.
        ;
        ; GATED on JITR being nonzero -- the unrolled LFSR draw is real
        ; cycle cost, and running it unconditionally pushed a fresh trig
        ; (already paying for RVRS's own draw in the worst case) over
        ; budget even though JITR=0 (the default) needs exactly zero
        ; offset regardless. Measured, not assumed: worst case was
        ; 3981/3951 with this always running, back under budget once
        ; gated -- but gating alone wasn't enough: the TRUE worst case
        ; (RVRS's own general-value draw AND JITR's draw BOTH firing on
        ; the same fresh trig) still measured 3988/3951, 37 over.
        ;
        ; TRUNCATED from RVRS's own full 8-step CONDITIONAL mix, in two
        ; stages (2026-11-05): first cut to 4 conditional steps measured
        ; 3967/3951 (still 16 over), cut to 2 conditional steps measured
        ; 3958/3951 (still 7 over, each conditional step only saving
        ; ~4-5 cycles). RVRS's draw needs its full 8 CONDITIONAL steps
        ; (true Galois taps, each gated on the shifted-out bit) because
        ; it feeds a probability comparison -- a weak mix would skew
        ; p_reverse's actual statistics in a measurable way. JITR has no
        ; such requirement -- it's a purely creative per-trig wiggle on
        ; an already-approximate loop-start position, not a probability
        ; draw -- so rather than keep shortening the CONDITIONAL mix
        ; (diminishing returns per step), switch to an UNCONDITIONAL
        ; 2-step mix instead: lsl+eor every time, not gated on the
        ; shifted-out bit via `bcc`. This is NOT a true Galois LFSR step
        ; (the tap is applied regardless of the bit that was shifted
        ; out, so the sequence's period/distribution guarantees don't
        ; hold), but that correctness was never something JITR actually
        ; needed -- only "looks different each trig" -- and this
        ; project's own established finding (NFX-UW round 3, NFX-B2 §4)
        ; is that BRANCHES, not instruction count, are the expensive
        ; resource on this emulator, so removing the conditional branch
        ; entirely should save more than shortening the branching chain
        ; did -- it measured 3950/3951, barely under (1 spare), too
        ; thin to trust (see the NFX-B2 hardware-margin lesson from the
        ; same day: a wafer-thin margin on brand-new code is a real risk
        ; this project has already been burned by once). Cut the
        ; unconditional mix to a single step to buy real headroom.
        move y:(r6+$8),a ; JITR, raw unipolar_q23
        tst a
        beq <JITR_DONE
        move y:(r6+$12),b ; RNG_STATE
        move #>$c20001,x1
        lsl b
        eor x1,b ; unconditional -- see comment above
        move b1,y:(r6+$12) ; store the advanced RNG_STATE
        move b1,y0 ; y0 = raw mixed bits, used DIRECTLY as a bipolar
                   ; Q23 fraction -- no masking (unlike RVRS's own
                   ; unipolar draw), since any pseudo-random 24-bit
                   ; pattern is already a valid signed Q23 value

        move y:(r6+$8),x0 ; JITR, raw unipolar_q23
        mpy y0,x0,a ; a = random_bipolar * JITR_fraction -- true
                    ; fraction * true fraction lands correctly in a1
        move a1,y0 ; y0 = scaled bipolar jitter fraction

        move #>LOGICAL_BUFLEN,x0
        mpy y0,x0,a ; a = jitter_offset, LOGICAL position units (bipolar)
        move a1,x0 ; x0 = jitter_offset

        move y:(r6+$1b),a ; LOOP_START (just stored above)
        add x0,a ; a = LOOP_START + jitter_offset (could now be
                 ; negative or >= LOGICAL_BUFLEN)

        ; wrap into [0, LOGICAL_BUFLEN) -- explicit compare+add/sub, NOT
        ; a bitmask (LOGICAL_BUFLEN=3072 isn't a power of 2). Jitter's
        ; own magnitude is bounded (|jitter_offset| < LOGICAL_BUFLEN,
        ; since both factors multiplying it are true fractions < 1.0),
        ; so a SINGLE correction in either direction always suffices --
        ; no loop needed.
        cmp #>LOGICAL_BUFLEN,a
        blt <JITR_LOW_CHECK
        sub #>LOGICAL_BUFLEN,a
        bra <JITR_WRAP_DONE
JITR_LOW_CHECK:
        tst a
        bge <JITR_WRAP_DONE
        add #>LOGICAL_BUFLEN,a
JITR_WRAP_DONE:
        move a1,y:(r6+$1b) ; LOOP_START, now jittered and wrapped
JITR_DONE:

        ; LOOP's raw fraction is SQUARED before scaling by
        ; LOGICAL_BUFLEN (2026-11-04, direct user request: "values
        ; close to zero have a higher resolution... logarithmic or
        ; square curve"). Same confirmed-correct "mpy of two TRUE Q23
        ; fractions lands in a1 directly" semantics already relied on
        ; throughout this file; same squaring idiom NFX-BO's own BEND
        ; shrink-branch already uses for an analogous reason (NFX-EN's
        ; own real firmware code does this too, per
        ; refs/GOLD_STANDARD.md). Squaring a fraction in [0,1) is always
        ; safe (result stays in [0,1), no overflow risk, no clamp
        ; needed for the squaring step itself) -- only the floor-clamp
        ; below (unrelated to this) is still needed.
        ;
        ; Effect: knob positions near 0 move LOOP_LEN only a LITTLE per
        ; step (d(x^2)/dx = 2x is small near x=0) -- fine resolution in
        ; the short-loop region where small absolute length changes
        ; have the biggest perceptual (pitch-like) effect. Positions
        ; near max move LOOP_LEN a LOT per step -- coarser there, where
        ; it matters less. This deliberately changes the exact linear
        ; "knob=64 -> half-length" reference point from this feature's
        ; original design conversation (now knob=64 -> ~1/4-length, since
        ; (64/127)^2 =~ 0.25) -- a known, intended consequence of moving
        ; to this curve, not an oversight.
        move y:(r6+$7),y0 ; LOOP_LEN, raw unipolar_q23
        move y0,x0
        mpy y0,x0,a ; a = LOOP_raw^2 (true fraction squared)
        move a1,y0 ; y0 = squared fraction
        move #>LOGICAL_BUFLEN,x0
        mpy y0,x0,a ; a = squared_fraction * LOGICAL_BUFLEN
        cmp #>LOOP_LEN_MIN,a
        bge <LOOPLEN_FLOOR_OK
        move #>LOOP_LEN_MIN,a
LOOPLEN_FLOOR_OK:
        move a1,y:(r6+$1c) ; LOOP_LEN (kept for reference/debugging only
                        ; -- PLAYBACK itself reads LOOP_END instead)

        ; LOOP_END = LOOP_START + LOOP_LEN, latched ONCE per trig (not
        ; recomputed every sample -- same reasoning as capture's own
        ; GATE-derived bounds). a1 still holds the just-stored (floored)
        ; LOOP_LEN -- the move above doesn't clobber the accumulator,
        ; so reuse it directly rather than re-reading Y-memory or
        ; relying on y0 (which still holds the ORIGINAL unfloored raw
        ; LOOP param, not this value).
        move y:(r6+$1b),x0 ; LOOP_START
        add x0,a ; a = START + (floored) LEN
        move a1,y:(r6+$1d) ; LOOP_END

        ; --- PB_POS starts at the loop region's own beginning;
        ; PB_DECIM_CTR seeded at DECIM_M1 so the first real sample of
        ; this pass advances immediately (same convention as capture's
        ; own DECIM_CTR seeding, just below). ---
        move y:(r6+$1b),a ; LOOP_START
        move a1,y:(r6+$18) ; PB_POS
        move #>DECIM_M1,a
        move a1,y:(r6+$19) ; PB_DECIM_CTR

        ; --- GATE: shapes how many logical samples writing is allowed
        ; for, in LOGICAL units (LOGICAL_BUFLEN, not BUFLEN) -- same
        ; derivation as NFX-BO's own GATE, just on the doubled count.
        ; Reading/output is NEVER gated by this, only writing is.
        move y:(r6+$2),x0
        move x0,a
        tst a
        bge <GATE_POS
        cmp #>$800000,a
        beq <GATE_NEG_MIN
        clr a
        sub x0,a
        bra <GATE_NEG_OK
GATE_NEG_MIN:
        move #>$7fffff,a
GATE_NEG_OK:
        move a1,y0 ; y0 = |GATE|
        move #>LOGICAL_BUFLEN,x0
        mpy y0,x0,a ; true fraction * plain integer: a1 lands correctly
        move a1,x0 ; x0 = missing logical samples
        move #>LOGICAL_BUFLEN,a
        sub x0,a ; a = CAP_REMAIN = LOGICAL_BUFLEN - missing
        move a1,y:(r6+$d)
        clr a
        move a,y:(r6+$f) ; GATE<0: stop early, no start delay
        bra <GATE_DONE
GATE_POS:
        move a1,y0 ; y0 = GATE (already >=0)
        move #>LOGICAL_BUFLEN,x0
        mpy y0,x0,a
        move a1,x1 ; x1 = missing logical samples
        move #>LOGICAL_BUFLEN,a
        sub x1,a
        move a1,y:(r6+$d)
        move x1,y1 ; y1 = missing logical samples (mpy needs x0/x1/y0/y1)
        move #>DECIM,x0
        mpy y1,x0,a ; plain int * plain int -- small, needs the
                    ; doubled-product undo
        asr a
        move a0,a
        move a1,y:(r6+$f) ; CAP_DELAY_REMAIN, in REAL samples
GATE_DONE:

        ; --- position start point: 0 counting up (forward) or
        ; LOGICAL_BUFLEN-1 counting down (reverse). One counter drives
        ; BOTH read and write for the whole pass.
        move y:(r6+$11),a ; REVERSE_FLAG
        tst a
        bne <POS_REV
        clr a
        move a,y:(r6+$c) ; forward: LOGICAL_POS=0
        bra <POS_DONE
POS_REV:
        move #>LOGICAL_BUFLEN,a
        sub #>1,a
        move a1,y:(r6+$c) ; reverse: LOGICAL_POS=LOGICAL_BUFLEN-1
POS_DONE:
        move #>WINDOW_SAMPLES,x0
        move x0,y:(r6+$10) ; WINDOW_REMAIN
        move #>DECIM_M1,x0
        move x0,y:(r6+$e) ; DECIM_CTR -- seeded at DECIM_M1 so the first
                          ; sample of a fresh pass advances immediately
                          ; (mirrors NFX-BO's own BOUNCE_BEGIN_PASS
                          ; reasoning for its own decim ctr -- wait, that
                          ; one seeds at 0, not DECIM_M1; here there is
                          ; no "previous pass" whose stale hold value
                          ; could bleed in, since HELD_WET is reset
                          ; below regardless -- seeding at DECIM_M1
                          ; just means the FIRST real sample of this
                          ; pass is itself a fresh decimated-step,
                          ; matching NFX-BO's capture-side CAP_DECIM_CTR
                          ; convention, not its bounce-side one)
        clr a
        move a,y:(r6+$13) ; PENDING_HALF=0 (irrelevant until first used)
        move a,y:(r6+$14) ; HELD_WET=0 -- fresh pass starts silent, no
                          ; stale amplitude from before (same reasoning
                          ; as NFX-BO's own HELD_WET reset)
        move a,y:(r6+$15) ; INTERP_STEP=0
        move #>1,a
        move a,y:(r6+$a) ; PHASE=ACTIVE
RENDER_NOTRIG:

        ; --- once per block: neighbour buffers for NBAL (identical to
        ; NFX-BO's own setup) ---
        move y:>$7f0,r5
        move #>$ffffff,m5
        move y:(r5+2),r2 ; two back
        move y:(r5+1),r5 ; one back
        move #>$ffffff,m2

        move y:(r6+$9),r3 ; r3 = this track's buffer base
        move #>$ffffff,m3

        ; --- once per block: cache NBAL/MIX derived values (same
        ; hoist-out-of-the-hot-loop principle as NFX-BO) ---
        move #>$7fffff,a
        move y:(r6+$1),y0 ; NBAL
        sub y0,a
        move a1,n0 ; n0 = cached 1-NBAL
        move y:(r6+$1),n1 ; n1 = cached NBAL

        move y:(r6+$5),a ; MIX
        cmp #>$7f0000,a
        bge <PRE_MIX_FULL_WET
        move #>$7fffff,a
        move y:(r6+$5),x0
        sub x0,a
        move a1,r1 ; r1 = cached 1-MIX
        bra <PRE_MIX_DONE
PRE_MIX_FULL_WET:
        clr a
        move a1,r1
PRE_MIX_DONE:
        move y:(r6+$5),r4 ; r4 = cached MIX

        ; --- cache PLAYBACK's own per-trig constants into otherwise-
        ; unused registers (n4/n5), same hoist-out-of-the-hot-loop
        ; principle as NBAL/MIX above -- these run EVERY sample now
        ; (not gated by DECIM_CTR like capture itself is, though
        ; PLAYBACK's own POSITION only advances on its own decimated
        ; schedule, see PB_DECIM_CTR below), so re-reading them from
        ; Y-memory 32 times/block instead of once was measured as a
        ; real, substantial cycle cost. RAMP_FRACTION no longer needs a
        ; cache register (r0, formerly) -- it's a true compile-time
        ; constant now, needed only transiently at the infrequent
        ; retarget site, loaded there directly as an immediate. ---
        move y:(r6+$1b),n4 ; n4 = cached LOOP_START
        move y:(r6+$1d),n5 ; n5 = cached LOOP_END

        ; --- PB_POS and PB_DECIM_CTR are STATE, not constants -- they
        ; change every sample -- but only need to PERSIST ACROSS BLOCKS,
        ; not be re-fetched WITHIN one. n6/n7 confirmed completely
        ; unused anywhere else in this file. Written back once after
        ; RENDER_END below. ---
        move y:(r6+$18),n6 ; n6 = cached PB_POS
        move y:(r6+$19),n7 ; n7 = cached PB_DECIM_CTR
RENDER_LOOP:
        do #32,RENDER_END
        ; dry = two_back*(1-NBAL) + one_back*NBAL -- convex combination,
        ; identical to NFX-BO's own (safe against the overflow class of
        ; bug found in that project: a plain delta-then-scale form can
        ; wrap on a sharp transient; this cannot, since the weights are
        ; both >=0 and sum to 1).
        move y:(r2)+,x0 ; x0 = two_back
        move y:(r5)+,y1 ; y1 = one_back
        move n0,y0
        mpy x0,y0,a
        move n1,x0
        macr y1,x0,a
        move a1,x1 ; x1 = dry sample, live until the final output mix

        clr b ; default silent wet output

        move y:(r6+$a),a ; PHASE
        tst a
        beq <RENDER_TAIL ; idle: output stays pure silence, skip
                        ; EVERYTHING below including the ramp -- avoids
                        ; HELD_WET drifting forever on a stale
                        ; INTERP_STEP if we fell into the ramp instead

        ; --- WINDOW_REMAIN countdown -- always runs, independent of
        ; GATE (GATE only ever shapes what gets WRITTEN, never when
        ; anything happens or how long reading continues) ---
        move y:(r6+$10),a
        sub #>1,a
        move a1,y:(r6+$10)
        blt <PASS_ENDING ; window just closed -- stop abruptly (no
                        ; decay mechanism here, this is a fixed-length
                        ; one-shot). MUST be "blt" (strictly negative),
                        ; not "ble": with "ble", WINDOW_REMAIN hitting
                        ; EXACTLY 0 ends the pass on the SAME sample as
                        ; the window's last valid sample, cutting off
                        ; the final decimated event before it can run.
                        ; "blt" lets WINDOW_REMAIN reach exactly 0 on a
                        ; valid sample and only ends the pass once it
                        ; goes negative, giving the full WINDOW_SAMPLES
                        ; samples of processing.

        ; --- DECIM_CTR gate: only the capture read/blend/write/advance
        ; work (inlined at DECIM_CALL below) runs on a decimated
        ; step; every OTHER sample just decrements and falls straight
        ; into PLAYBACK (capture and playback are fully
        ; decoupled: playback runs every sample regardless of this
        ; gate). ---
        move y:(r6+$e),a
        tst a
        ble <DECIM_CALL
        sub #>1,a
        move a1,y:(r6+$e)
        bra <PLAYBACK
DECIM_CALL:
        ; --- inline capture write (NOT a bsr/rts call -- measured in
        ; round 3 as a real, worthwhile saving over calling it as a
        ; subroutine). The reverse write-pairing fix and window-boundary
        ; fix from round 2 both still apply exactly as before -- this
        ; logic is otherwise unrelated to the SPED removal above. ---
        move #>DECIM_M1,a
        move a1,y:(r6+$e)

        move y:(r6+$c),a
        asr #1,a,a ; word-index = logical_pos >> 1 (single shift, safe)
        move a1,n3

        move y:(r6+$c),a
        and #>1,a ; sub_phase = logical_pos & 1 -- and's own flags are
                  ; enough for the branch below, no tst needed
        bne <READ_BOTTOM

        move y:(r3+n3),b
        asr #12,b,b
        move b1,a
        asl #12,a,a ; a1 = old_sample, Q23-ish, top half
        bra <READ_DONE
READ_BOTTOM:
        move y:(r3+n3),b
        asl #12,b,b
        move b1,a
        asr #12,a,a
        move a1,b
        asl #12,b,b
        move b1,a ; a1 = old_sample, Q23-ish, bottom half
READ_DONE:
        move a1,y1 ; y1 = old_sample, for the REC blend only

        move y:(r6+$16),a ; CAPTURE_ENABLED
        tst a
        beq <ADVANCE_POS_CAP

        move y:(r6+$f),a ; CAP_DELAY_REMAIN
        tst a
        ble <CAP_ACTIVE
        sub #>1,a
        move a1,y:(r6+$f)
        bra <ADVANCE_POS_CAP
CAP_ACTIVE:
        move y:(r6+$d),a ; CAP_REMAIN
        tst a
        ble <ADVANCE_POS_CAP
        sub #>1,a
        move a1,y:(r6+$d)

        move y:(r6+$17),y0 ; REC_SCALE
        mpy y1,y0,a ; true fraction * true fraction
        move a1,x0 ; x0 = REC_SCALE*old_sample

        cmp #>FEEDBACK_GATE,a
        bge <FBGATE_KEEP
        cmp #>FEEDBACK_GATE_NEG,a
        ble <FBGATE_KEEP
        clr a
        move a1,x0
FBGATE_KEEP:

        move x1,a
        add x0,a ; a = dry + (gated) scaled old content
        cmp #>$7fffff,a
        ble <BLEND_CLAMP_LO
        move #>$7fffff,a
BLEND_CLAMP_LO:
        cmp #>$800000,a
        bge <BLEND_CLAMPED
        move #>$800000,a
BLEND_CLAMPED:
        asr #12,a,a ; quantize to signed 12-bit
        move a1,y1 ; y1 = quantized half (old_sample no longer needed)

        move y:(r6+$c),a
        and #>1,a ; sub_phase (0 or 1) -- and's own flags survive the
                  ; plain move below, no tst needed
        move a1,x0 ; x0 = sub_phase (0 or 1)
        bne <WPAIR_BOTTOM

        move y1,a
        and #>$fff,a
        asl #12,a,a
        move a1,y1 ; y1 = this event's value, positioned
        bra <WPAIR_POS_DONE
WPAIR_BOTTOM:
        move y1,a
        and #>$fff,a
        move a1,y1 ; y1 = this event's value, positioned
WPAIR_POS_DONE:

        move y:(r6+$11),a ; REVERSE_FLAG
        cmp x0,a
        beq <FIRST_OF_PAIR

        move y:(r6+$13),a ; PENDING_HALF (already positioned)
        add y1,a
        move a1,y:(r3+n3)
        bra <ADVANCE_POS_CAP
FIRST_OF_PAIR:
        move y1,a
        move a1,y:(r6+$13) ; PENDING_HALF

ADVANCE_POS_CAP:
        move y:(r6+$11),a ; REVERSE_FLAG
        tst a
        bne <POS_STEP_REV
        move y:(r6+$c),a
        add #>1,a
        bra <POS_STEP_DONE
POS_STEP_REV:
        move y:(r6+$c),a
        sub #>1,a
POS_STEP_DONE:
        move a1,y:(r6+$c)

PLAYBACK:
        ; --- independent read head, decoupled from capture, scrubbing
        ; through [LOOP_START, LOOP_END) at a plain decimated-advance
        ; rate (PB_DECIM_CTR counts down exactly like capture's own
        ; DECIM_CTR; PB_POS advances by a clean +1 only when it hits
        ; zero). REDESIGNED 2026-11-04 along with SPED's removal: this
        ; used to be a fixed-point Q(12.8) phase accumulator with a
        ; variable STEP_SIZE (needed because SPED let the rate vary
        ; continuously) -- with SPED gone the rate is always exactly
        ; DECIM's own cadence, so that general machinery was pure
        ; overhead on the 3-out-of-4 samples that never cross a
        ; position boundary. This plain countdown is both simpler and
        ; measurably cheaper on exactly those samples. ---
        move n7,a ; PB_DECIM_CTR
        tst a
        ble <PB_ADVANCE
        sub #>1,a
        move a1,n7
        bra <PB_SAME
PB_ADVANCE:
        move #>DECIM_M1,a
        move a1,n7 ; reset PB_DECIM_CTR

        ; advance PB_POS by exactly +1, wrapping to LOOP_START if that
        ; reaches/passes LOOP_END. No subtraction needed for the wrap
        ; (unlike the old fixed-point version, which had to handle an
        ; arbitrary overshoot from a variable STEP_SIZE) -- PB_POS is
        ; always kept in-range beforehand, so a +1 step can land AT
        ; LOOP_END but never past it, making "if >=END, set to START"
        ; exact.
        move n6,a ; PB_POS
        add #>1,a
        move n5,x0 ; x0 = cached LOOP_END
        cmp x0,a
        blt <PB_WRAP_DONE
        move n4,a ; wrap: PB_POS = LOOP_START
PB_WRAP_DONE:
        move a1,n6 ; store PB_POS (register, not Y-memory)

        ; --- REAL BUG, found 2026-11-04 while designing a jitter
        ; feature that would make it far more likely to actually hit:
        ; PB_POS tracks the LOOP REGION (can legitimately exceed
        ; LOGICAL_BUFLEN whenever LOOP_START is near the buffer's own
        ; end and LOOP_LEN is sizable -- the design doc explicitly
        ; claims the loop region "wraps circularly past the buffer's
        ; own physical end," but nothing before this fix actually
        ; implemented that for PLAYBACK's real addressing). Using
        ; PB_POS DIRECTLY as the buffer address once it exceeds
        ; LOGICAL_BUFLEN would read/write past this track's own
        ; TRACK_BUFFERS region -- memory corruption, possibly into
        ; another track's buffer. Max possible PB_POS is just under
        ; 2*LOGICAL_BUFLEN (LOOP_START and LOOP_LEN are each capped at
        ; LOGICAL_BUFLEN), so a SINGLE subtract (not a modulo loop)
        ; is enough -- but it must be an explicit compare+subtract,
        ; NOT a bitmask: LOGICAL_BUFLEN (3072) is not a power of 2.
        ; This is a SEPARATE wrap from the loop-region one just above:
        ; that one decides when PB_POS resets to LOOP_START; this one
        ; only affects what physical word gets addressed, not PB_POS
        ; itself (which keeps tracking the loop region in its own,
        ; possibly-past-buffer-end terms for the NEXT comparison
        ; against LOOP_END). ---
        cmp #>LOGICAL_BUFLEN,a
        blt <PB_ADDR_OK
        sub #>LOGICAL_BUFLEN,a
PB_ADDR_OK:

        ; fetch the new target at the (physically-wrapped) address and
        ; recompute INTERP_STEP so HELD_WET ramps smoothly to it, same
        ; decimated-hold-with-interpolation shape as NFX-BO.
        move a1,x0 ; x0 = physical address (still in a1 from above)
        asr #1,a,a ; word-index = physical address >> 1
        move a1,n3

        move x0,a
        and #>1,a ; sub_phase = PB_POS & 1 -- and's own flags are
                  ; enough for the branch below (confirmed via direct
                  ; probe: and_flags_direct_test.asm56k), no tst needed
        bne <PB_READ_BOTTOM

        move y:(r3+n3),b
        asr #12,b,b
        move b1,a
        asl #12,a,a
        bra <PB_READ_DONE
PB_READ_BOTTOM:
        move y:(r3+n3),b
        asl #12,b,b
        move b1,a
        asr #12,a,a
        move a1,b
        asl #12,b,b
        move b1,a
PB_READ_DONE:
        move a1,y0 ; y0 = new target

        ; INTERP_STEP = (target-HELD_WET)*RAMP_FRACTION_FIXED. Pre-halve
        ; the full-accumulator diff (which can reach +/-2.0) before
        ; truncating into a plain register for the mpy.
        move y0,a
        move y:(r6+$14),x0 ; HELD_WET
        sub x0,a ; a = target-HELD_WET, full accumulator, up to +/-2.0
        asr a ; a = diff/2, safely within +/-1.0

        move a1,x0 ; x0 = diff/2
        move #>RAMP_FRACTION_FIXED,y0 ; a true compile-time constant now
                        ; (not knob-derived), loaded directly here since
                        ; it's only needed at this infrequent (DECIM-
                        ; gated) retarget site, not every sample --
                        ; mpy's own source-operand constraint (x0/x1/
                        ; y0/y1 only, never a0/a1/b0/b1) still applies.
        mpy x0,y0,a ; a = (diff/2)*RAMP_FRACTION_FIXED
        asl a ; a = diff*RAMP_FRACTION_FIXED -- undo the earlier
             ; halving. Safe: the mpy just above writes a genuinely NEW
             ; value into 'a' (not a shift), breaking any fusion risk
             ; with the earlier "asr a".
        move a1,y:(r6+$15) ; INTERP_STEP
PB_SAME:

        ; --- stream HELD_WET's ramp every sample (hold or advance
        ; alike) -- same decimated-hold-with-interpolation approach as
        ; NFX-BO: a hard jump every DECIM samples is audibly harsh,
        ; this smooths it. ---
        move y:(r6+$15),x0 ; INTERP_STEP
        move y:(r6+$14),a ; HELD_WET
        add x0,a
        move a1,y:(r6+$14)
        move a1,b ; b = this sample's wet output
        bra <RENDER_TAIL

PASS_ENDING:
        clr a
        move a,y:(r6+$a) ; PHASE=IDLE -- pass is over, stop abruptly
        bra <RENDER_TAIL ; (b stays silent from clr b above)

RENDER_TAIL:
        ; --- output: dry*(1-MIX) + wet*MIX ---
        move r1,y0
        mpy x1,y0,a
        move r4,y0
        move b1,x0
        macr x0,y0,a
        move a,y:(r7)+
RENDER_END:
        ; persist n6/n7 (PB_POS/PB_DECIM_CTR) back to Y-memory once per
        ; block.
        move n6,y:(r6+$18) ; PB_POS
        move n7,y:(r6+$19) ; PB_DECIM_CTR
        rts
