; NUW-TS v1 -- NUW-JT's self-sampling overdub/freeze engine, rebuilt
; 2026-11-06 from NUW-JT's own CURRENT (post bulk-pass) build, with
; JITR (random per-trig position jitter) replaced by SPED -- a
; bidirectional tape-speed/pitch-bend knob on PLAYBACK only. -ve=slower,
; +ve=faster, 0=same speed as recorded. Round 2 (2026-11-07): SPED's
; rate is now TRULY CONTINUOUS (a fixed-point fractional phase
; accumulator), not the 5 discrete octave steps round 1 shipped --
; direct user request for "infinitely" variable speed (see the SPED
; header comment below and DESIGN.md Sec 17 for the full writeup).
; This is a direct revival of round 3's own SPED knob (removed
; 2026-11-04 after a real calibration bug), but deliberately NOT a
; straight resurrection of that old design: round 3's SPED also
; supported REVERSE direction on PLAYBACK (requiring general over/
; undershoot handling in its own phase accumulator, plus forward/
; backward-specialized loop bodies) -- this round drops that half
; entirely, per direct user instruction ("not backwards vs forwards
; this time rather faster vs slower"), so PLAYBACK stays forward-only.
; Dropping direction is what keeps THIS round's accumulator simple
; despite being continuous (see below) -- no over/undershoot handling,
; no loop-body split, just a single capped-rate forward accumulator.
; Built from NFX-BO's patterns (same INIT/TRIG idiom, same RVRS
; mechanism, same convex-combination and clamp-sum safety patterns) but
; architecturally different: no RATE/BEND/DCAY, no decaying bounce
; train. Every trig
; runs a SINGLE unified pass through its own capture buffer: read each
; position's existing content (that becomes this sample's output),
; optionally blend it with a fresh live capture and write the blend
; back, then advance -- sound-on-sound overdub, not record-then-play.
; See BRIEF.md / DESIGN.md for the full spec and reasoning.
;
; Parameter block (Y, relative to r6):
;   Y+1 NBAL  unipolar_q23  neighbour blend: 0=two back(far) 1=one back(near)
;   Y+2 GATE  bipolar_q23   capture-window shaping, 0=full window
;   Y+3 REC   unipolar_q23  0=pure fresh capture (old content ignored).
;                           1..~126=old content folded back at a REC-
;                           scaled level, summed with a full-level fresh
;                           capture, clamped. ~127 (knob=127 raw value)
;                           disables writing entirely -- pure replay;
;                           the live neighbour blend only reaches the
;                           OUTPUT via MIX's dry side, never the buffer.
;   Y+4 RVRS  bipolar_q23   reverse-capture probability -- IDENTICAL
;                           mechanism to NFX-BO's own RVRS (see that
;                           file's header for the full derivation):
;                           $800000=ALWAYS reverse, >=$7e0000=NEVER,
;                           else p_reverse=(1-RVRS)/2 vs a 24-bit
;                           Galois LFSR draw. Only drawn on trigs where
;                           capture actually runs (REC<~127).
;   Y+5 MIX   unipolar_q23  dry/wet on the OUTPUT only -- never affects
;                           what's written to the buffer (capture reads
;                           the pre-mix dry signal, same as NFX-BO).
;   Y+6 START unipolar_q23  (displayed as "STRT" -- MDS param names are
;                           capped at 4 characters, same reason NFX-BO's
;                           DECIM became DECM) playback loop region's
;                           start, as a fraction of LOGICAL_BUFLEN.
;   Y+7 LOOP_LEN unipolar_q23  (displayed as "LOOP") playback loop
;                           region's length, as a fraction of
;                           LOGICAL_BUFLEN (floored to a minimum of 1
;                           logical position). Classic sampler loop-point
;                           semantics: the read head wraps within
;                           [START, START+LOOP_LEN) -- circularly past
;                           the buffer's own physical end if needed --
;                           for as long as the trig's fixed
;                           WINDOW_SAMPLES duration lasts. Max value =
;                           the loop region spans the rest of the
;                           window, so it only plays once (no time left
;                           to wrap back). Small values wrap many times
;                           within the same fixed duration.
;
; Y+8 SPED  bipolar_q23  bidirectional tape-speed/pitch-bend on
;                           PLAYBACK only (capture's own rate is NEVER
;                           affected -- it stays fixed at DECIM's own
;                           cadence always, exactly as before). 0
;                           (knob=64, the center/default) = same speed
;                           as recorded, identical to pre-SPED
;                           behavior; negative = slower (lower pitch,
;                           like a tape machine slowing down); positive
;                           = faster (higher pitch). TRULY CONTINUOUS
;                           (round 2, 2026-11-07 -- round 1 shipped 5
;                           discrete octave-exact steps; direct user
;                           request for "infinitely" variable speed
;                           replaced that with a real fixed-point
;                           fractional phase accumulator -- see
;                           STEP_SIZE_Q8/PB_FRAC below). Range: ~4x
;                           slower at the knob's negative extreme, ~4x
;                           faster at its positive extreme, continuously
;                           in between -- same outer range round 1's
;                           discrete steps covered, just smooth now.
;
; This is a direct revival of round 3's SPED knob (NUW-JT's own
; DESIGN.md Sec 8-10), REMOVED 2026-11-04 after a real hardware report
; ("the speed parameter just makes it sound like hell" / "at 0 speed
; nothing happens") -- root cause was a genuine 2x calibration error in
; RAMP_FRACTION's derivation (used the UNCLAMPED raw knob value instead
; of the actual clamped rate, and was off by one shift besides). This
; round's design deliberately avoids resurrecting that whole class of
; bug while STILL being genuinely continuous: round 3 needed its own
; phase accumulator to handle a variable-MAGNITUDE, variable-SIGN
; STEP_SIZE (general over/undershoot correction, forward/backward-
; specialized loop bodies) because it ALSO supported reverse direction
; -- per direct user instruction this round ("not backwards vs forwards
; this time rather faster vs slower"), PLAYBACK stays forward-only, so
; STEP_SIZE_Q8 here is always POSITIVE and explicitly CAPPED at 255
; (just under the Q8 "1.0 logical position per real sample" boundary)
; -- capping it there guarantees AT MOST ONE integer-position crossing
; per real sample, so the accumulator never needs a loop or a general
; multi-step correction, just the SAME single compare-and-wrap shape
; round 1's own discrete-PERIOD counter already used (see PB_FRAC
; below) -- continuous, but not more structurally complex than the
; discrete design it replaces.
;
; RAMP_FRACTION (the interpolation ramp's own divide-by-rate step) is
; derived as STEP_SIZE_Q8<<15 -- a Q23 TRUE fraction, computed via a
; single FIXED-immediate shift (not register-sourced, since the shift
; AMOUNT itself, 15, is a true compile-time constant here -- only the
; VALUE being shifted, STEP_SIZE_Q8, varies per trig). This is the
; SAME formula round 3's own design needed, correctly this time: that
; design's real bug was using the knob's UNCLAMPED raw value here
; instead of the actual clamped STEP_SIZE, compounded by using <<16
; instead of the correct <<15. Verified directly via probe
; (decay_ramp_fraction_test.asm56k -- see DESIGN.md Sec 17) that this
; derivation lands on EXACTLY the same RAMP_FRACTION round 1's own
; baseline case did ($200000, 0.25, matching 1/DECIM) before trusting
; it for the continuous range.
;
; START/LOOP_LEN stay at Y+6/Y+7 (unchanged from the current NUW-JT
; build); SPED (above) now fills the same trailing Y+8 slot JITR used
; to occupy. PLAYBACK's own loop region (START/LOOP_LEN -> LOOP_START/
; LOOP_END) is completely unaffected by SPED -- only HOW FAST the read
; head moves through that region changes, never WHERE the region itself
; is.
;
; REAL BUG found and fixed while designing JITR (2026-11-04), independent
; of jitter itself: PLAYBACK's read head never wrapped its own position
; back into the PHYSICAL buffer range when the loop region (as this
; design always claimed) extends past the buffer's own end -- it could
; read/write OUTSIDE this track's TRACK_BUFFERS region. A static,
; user-chosen STRT rarely landed there; JITR's own random walk makes it
; far more likely, which is what surfaced this during design rather
; than after shipping. See PLAYBACK's own PB_ADDR_OK comment for the fix.
;
; 12-bit sample packing: two signed 12-bit samples share one 24-bit
; Y-memory word, doubling effective buffer capacity (LOGICAL_BUFLEN =
; BUFLEN*2 = 3072 logical positions) independent of DECIM. A logical
; sample index replaces a plain word index; word-index = logical>>1,
; sub-phase = logical&1 (0=top 12 bits, 1=bottom 12). Quantize via
; asr #12 (top 12 bits, already sign-extended); pack two quantized
; halves by masking each to #$fff and shifting the first left 12 before
; adding; unpack a half by shifting to reposition (bottom half only)
; then sign-extending (asr #12) then rescaling back to Q23 range
; (asl #12, bottom 12 bits now zero -- the quantization noise floor,
; SP-1200/S900-style character).
;
; CRITICAL, confirmed via direct probe (dsp56300/cyclecheck/sign_test/
; shift12_isolate*.asm56k, pack12_test2.asm56k) BEFORE relying on it:
; two consecutive immediate-shift instructions naming the SAME register
; silently merge into one NET shift (asr counts negative, asl positive)
; regardless of what unrelated instructions sit between them -- "asr
; #12,a,a" then "asl #12,a,a" nets to a complete no-op, not two
; independent shifts. Only a genuine WRITE to that register from
; elsewhere breaks the merge. Fix, used throughout below: alternate
; registers for every such pair (shift on b, move b1,a, shift on a) --
; never two shifts in a row naming the same register. Same-direction
; chains (two asr's, two asl's) compound correctly and don't need this.
;
; Persistent state (Y, relative to r6; all free words past the 7 params,
; Y+8 itself also free -- see the Y+6/Y+7 header comments above):
;   Y+9  TRACKMEM_BASE   this track's TRACK_BUFFERS base word address
;   Y+10 PHASE           0=IDLE 1=ACTIVE (a pass is running)
;   Y+11 TRIG_FLAG       set by TRIG, consumed once by RENDER
;   Y+12 LOGICAL_POS     current logical sample index, drives BOTH the
;                        read (output) and the write (capture) side of
;                        the unified pass -- there is only one position,
;                        not separate capture/bounce heads like NFX-BO,
;                        since here they are the same pass.
;   Y+13 CAP_REMAIN      logical samples left for which writing is still
;                        allowed this trig (GATE-derived countdown).
;                        Reading/output is NEVER gated by this -- only
;                        writing is. Irrelevant (not decremented) when
;                        CAPTURE_ENABLED=0.
;   Y+14 DECIM_CTR       real-sample countdown between decimated steps
;   Y+15 CAP_DELAY_REMAIN real samples to wait before writing starts
;                        (GATE>0 case, delays the WRITE only, not reading)
;   Y+16 WINDOW_REMAIN   Q6-scaled logical distance left in the pass
;                        (seeded WINDOW_SAMPLES_Q6 = LOGICAL_BUFLEN*
;                        DECIM<<6, GATE-independent -- same "GATE shapes
;                        WHAT, never WHEN" principle as NFX-BO). Drains
;                        by STEP_SIZE_Q8 every real sample (2026-11-09,
;                        round 3 -- was a flat 1/sample pre-this-round),
;                        so the pass's own real-world duration scales
;                        with SPED exactly the way PLAYBACK's position
;                        does: at LOOP=127 (loop region = full content)
;                        the loop region and this budget now always run
;                        out together, so it plays exactly once at any
;                        speed instead of re-looping when sped up; at
;                        LOOP<127 the loop region still wraps multiple
;                        times, but the whole pass still ends in
;                        proportionally less/more wall-clock time, not
;                        the old fixed sample count. Reaching zero ends
;                        the pass (PHASE goes back to IDLE).
;   Y+17 REVERSE_FLAG    this trig's pass direction (0=forward from
;                        logical 0 upward, 1=reverse from
;                        LOGICAL_BUFLEN-1 downward). Controls BOTH read
;                        and write together -- they are the same pass,
;                        unlike NFX-BO where capture's write-direction
;                        and bounce's read-direction are independent.
;   Y+18 RNG_STATE       24-bit Galois LFSR state, same mechanism as
;                        NFX-BO's RVRS. Seeded nonzero in INIT, never
;                        reset (a zero seed is this LFSR's fixed point).
;   Y+19 PENDING_HALF    on a phase-0 write event, the quantized half is
;                        stashed here (not written to memory yet); on
;                        the matching phase-1 event, it's packed with
;                        that event's own half and the complete word is
;                        written in one go -- avoids any read-modify-
;                        write on a half-complete word.
;   Y+20 HELD_WET        continuously-ramping interpolated output,
;                        nudged by INTERP_STEP every sample (same
;                        decimated-hold-with-interpolation approach as
;                        NFX-BO -- a hard jump every DECIM samples is
;                        audibly harsh, this smooths it).
;   Y+21 INTERP_STEP     per-sample increment ramping HELD_WET toward
;                        the latest target over DECIM samples
;   Y+22 CAPTURE_ENABLED 0/1, latched once per trig from REC's raw value
;   Y+23 REC_SCALE       Q23 fraction scaling old content's contribution
;                        to the write-back blend, latched once per trig
;   Y+24 PB_POS           PLAYBACK's own read position, in plain LOGICAL
;                        units (NOT fixed-point -- see the note below on
;                        why this no longer needs to be). Independent of
;                        LOGICAL_POS (the write head). Always kept
;                        wrapped within [LOOP_START, LOOP_END).
;   Y+25 PB_FRAC          fractional phase accumulator, Q8 (range
;                        [0,256)), cached in register n7 across the
;                        whole block (persisted back here once at
;                        RENDER_END, same pattern as PB_POS/n6).
;                        STEP_SIZE_Q8 (Y+26) is added to it EVERY real
;                        sample; when it would reach/pass 256, it wraps
;                        (-=256) and PB_POS advances by exactly +1 --
;                        since STEP_SIZE_Q8 is capped at 255 (see the
;                        SPED header comment), this can happen AT MOST
;                        once per real sample, so the check is a single
;                        compare+branch, same shape as round 1's own
;                        discrete-PERIOD countdown, just counting UP
;                        instead of down. Must be checked on EVERY one
;                        of the 4 inner do#8 positions, not just the
;                        decimated 4th one -- SPED's rate is independent
;                        of capture's own fixed stride, so a crossing
;                        can land on any of the 4 group-local positions
;                        (see RENDER_LOOP's own header comment).
;   Y+26 STEP_SIZE_Q8     this trig's SPED-derived rate, in Q8 position-
;                        units-per-real-sample (256=1.0, i.e. one whole
;                        logical position every real sample). Baseline
;                        (SPED=0) = 64 (256/DECIM, matching the pre-SPED
;                        fixed rate exactly); range ~16 (4x slower) to
;                        255 (just under 4x faster, capped -- see the
;                        SPED header comment for why never exactly
;                        256). Cached in register r0 across the whole
;                        block. Reused slot -- held PB_SHIFT_EXP in
;                        round 1's discrete-PERIOD design.
;   Y+27 LOOP_START       plain-integer loop-region start (logical
;                        units), latched once per trig (= STRT_raw *
;                        LOGICAL_BUFLEN -- same mpy semantics GATE
;                        already uses for its own analogous derivation,
;                        no Q8 scaling needed anymore either).
;   Y+28 LOOP_LEN         plain-integer loop-region length, latched once
;                        per trig, floored to a minimum of 1 logical
;                        position. Kept for reference only -- PLAYBACK
;                        itself reads LOOP_END (Y+29) instead, below.
;   Y+29 LOOP_END         = LOOP_START + LOOP_LEN, latched once per trig.
;                        Cached into n5 for the whole block (see
;                        RENDER_LOOP's once-per-block caching) alongside
;                        LOOP_START (n4). Because PB_POS only ever
;                        advances by exactly +1 and is always kept
;                        in-range beforehand, wrapping needs no
;                        subtraction at all -- "if PB_POS>=LOOP_END,
;                        set PB_POS=LOOP_START" is exact (the old
;                        fixed-point version needed a general
;                        phase-END+START correction because a variable
;                        STEP_SIZE could overshoot by an arbitrary
;                        amount; a fixed +1 step never can).
;   Y+30 RAMP_FRACTION    this trig's SPED-derived Q23 TRUE fraction
;                        (= STEP_SIZE_Q8<<15 -- see the SPED header
;                        comment above for the full derivation and why
;                        it's correct this time), cached in register n2
;                        across the whole block. Used by the per-sample
;                        PLAYBACK block's own INTERP_STEP computation,
;                        same mpy-based halve-then-double pattern
;                        NUW-JT's own pre-SPED-revival build already
;                        used (just with a knob-derived fraction instead
;                        of the fixed RAMP_FRACTION_FIXED constant).
;                        Reused slot -- held PB_PERIOD_M1 in round 1's
;                        discrete-PERIOD design.
;   Y+31 PB_FRAC persistent backing -- NEW slot (workset grew by 1
;                        word for round 1's SPED revival, see
;                        NUWTS.json; unchanged shape, just reinterpreted
;                        for round 2's continuous accumulator). The
;                        running value itself lives in register n7
;                        for the WHOLE block (read fresh here once at
;                        the top of RENDER, written back once at
;                        RENDER_END -- registers do not reliably
;                        survive between separate RENDER calls, same
;                        reason PB_POS itself round-trips through
;                        Y-memory via n6). Seeded to 0 at trig-time
;                        (a fresh pass starts exactly on-phase; unlike
;                        round 1's countdown convention, there is no
;                        "advance immediately" case to engineer for --
;                        PB_POS already starts correctly at LOOP_START,
;                        and PB_FRAC=0 simply means the first sample's
;                        accumulation starts from a clean zero).
;
; Fixed-point notes carried forward from NFX-BO (empirically verified,
; not assumed -- see that file's own header and refs/GOLD_STANDARD.md):
;   - mpy of a TRUE Q23 fraction times a PLAIN INTEGER lands correctly
;     in a1 directly, no extra shift needed.
;   - mpy of two PLAIN INTEGERS (small, no fractional intent) needs
;     "asr a" then "move a0,a" to undo the doubled-product convention.
;   - mpy's source operands must be x0/x1/y0/y1 -- never a0/a1/b0/b1.


.equ BUFLEN 1536 ; TRACK_BUFFERS words/track (hardware allocation)
.equ LOGICAL_BUFLEN 3072 ; = BUFLEN*2, two 12-bit samples/word
.equ DECIM 4 ; real samples skipped per stored logical sample. Same
             ; default as NFX-BO; MUST keep DECIM_SHIFT below in sync by
             ; hand (no log2() in this project's assembler).
.equ DECIM_SHIFT 2 ; = log2(DECIM)
.equ DECIM_M1 3 ; = DECIM-1
.equ WINDOW_SAMPLES 12288 ; = LOGICAL_BUFLEN*DECIM (~278ms at DECIM=4 --
                          ; double NFX-BO's ~139ms at the same DECIM,
                          ; the whole point of 12-bit packing)
.equ WINDOW_SAMPLES_Q6 786432 ; = WINDOW_SAMPLES<<6 (2026-11-09, direct
                          ; user report/request: at LOOP=127 a faster
                          ; SPED should still play exactly once, not
                          ; re-loop -- and at LOOP<127 the whole pass
                          ; should still finish in proportionally less
                          ; wall-clock time, not the same fixed sample
                          ; count as 1x speed). WINDOW_REMAIN now drains
                          ; by STEP_SIZE_Q8 each real sample instead of
                          ; a flat 1, so the whole pass's real-world
                          ; duration scales with speed exactly the way
                          ; PLAYBACK's own position does -- the <<6 here
                          ; is what makes STEP_SIZE_Q8=64 (1x baseline)
                          ; drain this exactly WINDOW_SAMPLES times,
                          ; unchanged from the pre-SPED fixed-1 behavior.
.equ GAP_FLOOR 8 ; unused here (no bounce-restart concept) -- kept only
                 ; if a future round adds one; harmless if never read.
.equ LEVEL_THRESHOLD $000800 ; unused here, same reason as GAP_FLOOR
.equ FEEDBACK_GATE $001000 ; feedback-loop breaker (2026-11-04, user
                 ; report: runaway buildup, especially on reverse).
                 ; REC's overdub is a closed feedback loop with no
                 ; forced decay (unlike NFX-BO's DCAY) -- near-silent
                 ; residue, and the 12-bit quantization's own rounding
                 ; bias (asr rounds toward -inf for negative values,
                 ; toward 0 for positive ones -- NOT symmetric), can
                 ; otherwise recirculate and slowly compound forever.
                 ; Below this magnitude, the OLD content's scaled
                 ; contribution is forced to exact zero before being
                 ; added to the fresh capture, breaking the cycle.
                 ; Provisional value (~-66dB) -- revisit by ear.
.equ FEEDBACK_GATE_NEG $fff000 ; = -FEEDBACK_GATE (two's complement)
.equ CAPTURE_DRY_HEADROOM $65ac8c ; = -2dB as a true Q23 fraction
                 ; (2026-11-09, direct user report: dry input running hot
                 ; plus REC_SCALE*old_sample on top regularly pushed the
                 ; capture blend sum past Q23 full scale into the hard
                 ; clamp below, heard as "digital degradation", worse
                 ; with a low-frequency old_sample since it sustains near
                 ; its own peak longer per cycle than a high-frequency one
                 ; -- user's own diagnosis, confirmed against this exact
                 ; clamp. Applied ONLY to dry's contribution to the
                 ; CAPTURE WRITE blend below, not to the live MIX monitor
                 ; output (TAIL_Gx, unaffected) and not to NUW-JT (user
                 ; wants this machine, and NUW-PT identically, changed;
                 ; NUW-JT left alone -- same latent clamp risk there,
                 ; just not yet reported).
.equ LOOP_LEN_MIN 1 ; one whole logical position -- the loop region can
                 ; never collapse to zero width.
; RAMP_FRACTION_FIXED (the old compile-time 0.25=1/DECIM constant) is
; retired as of SPED round 2 -- PLAYBACK's own ramp fraction is now the
; per-trig, knob-derived RAMP_FRACTION (Y+30), not a fixed constant.
; See the SPED header comment above for the current derivation.


INIT:
        ; TRACKMEM base = r1 * 1536, rounded up to the next 512-word
        ; boundary. Identical pattern to NFX-BO/NFX-EN's own confirmed-
        ; working INIT -- see refs/GOLD_STANDARD.md section 3.
        move r1,y0 ; r1 = this track's number (0-15)
        move #>BUFLEN,x0
        mpy y0,x0,a ; confirmed-correct pairing (never mpy y0,y1,a --
                    ; that silently returns zero on this hardware)
        asr a
        move a0,a
        move a1,y1
TRACKMEM:
        move #>$0,x0 ; placeholder, patched by the loader to track 0's
                     ; TRACK_BUFFERS base (kind-2 import, symbol 6)
        move y1,a
        add x0,a
        move a1,r0
        move r0,y:(r6+$9)

        ; clear this track's whole TRACK_BUFFERS region (spec: "clear
        ; it before reading" -- it may hold another machine's data).
        ; All-zero packs to all-zero either way, so a freshly-cleared
        ; buffer reads back as silence everywhere until first written --
        ; no separate "valid length" tracking needed.
        move #>$ffffff,m0
        clr a
        rep #BUFLEN
        move a,y:(r0)+

        clr a
        move a,y:(r6+$a)
        move a,y:(r6+$b)
        move a,y:(r6+$c)
        move a,y:(r6+$d)
        move a,y:(r6+$e)
        move a,y:(r6+$f)
        move a,y:(r6+$10)
        move a,y:(r6+$11)
        move a,y:(r6+$13)
        move a,y:(r6+$14)
        move a,y:(r6+$15)
        move a,y:(r6+$16)
        move a,y:(r6+$17)
        move a,y:(r6+$18)
        move a,y:(r6+$19)
        move a,y:(r6+$1a)
        move a,y:(r6+$1b)
        move a,y:(r6+$1c)
        move a,y:(r6+$1d)
        move a,y:(r6+$1e) ; RAMP_FRACTION (not strictly required -- SPED
                          ; always derives and stores a fresh value at
                          ; every single trig before it's ever read --
                          ; but cleared anyway for consistency)
        move a,y:(r6+$1f) ; PB_FRAC persistent backing, same
                          ; reasoning as RAMP_FRACTION just above
        ; RNG_STATE (Y+18/$12) must NOT be zero -- a Galois LFSR seeded
        ; at 0 is a fixed point (lsl(0)=0, carry always 0, eor never
        ; fires: it would stay 0 forever). Same precedent as NFX-BO's
        ; own INIT and pluck.asm56k's own comment ("any nonzero noise
        ; state").
        move #>$5a5a5a,x0
        move x0,y:(r6+$12)
        rts

TRIG:
        move #>$1,x0
        move x0,y:(r6+$b)
        rts

RENDER:
        ; --- once per block: consume a fresh trig, if any ---
        move y:(r6+$b),a
        tst a
        beq <RENDER_NOTRIG
        clr a
        move a,y:(r6+$b)

        ; --- REC: decide CAPTURE_ENABLED and REC_SCALE once per trig ---
        ; REC is unipolar_q23. Firmware's knob=127 encoding (knob<<16)
        ; falls short of Q23's true $7fffff ceiling (same shortfall
        ; MIX/NFX-BO already works around) -- snap at that threshold so
        ; "127 disables capture" is exact, not merely "almost always".
        move y:(r6+$3),x0 ; REC, raw unipolar_q23
        move x0,a
        cmp #>$7f0000,a
        bge <REC_DISABLE
        move #>1,a
        move a1,y:(r6+$16) ; CAPTURE_ENABLED=1
        move x0,a
        move a1,y:(r6+$17) ; REC_SCALE = REC's own raw fraction directly
        bra <REC_DONE
REC_DISABLE:
        clr a
        move a1,y:(r6+$16) ; CAPTURE_ENABLED=0
        move a1,y:(r6+$17) ; REC_SCALE=0 (unused when disabled, but
                           ; keep it well-defined)
REC_DONE:

        ; --- RVRS: decide REVERSE_FLAG, same mechanism as NFX-BO ---
        ; (see NFXBO.asm56k's own header for the full derivation notes;
        ; reused verbatim here, only the destination offsets differ).
        ; When capture is disabled this trig, direction is irrelevant
        ; for WRITING (nothing gets written), but the unified pass still
        ; needs a direction for READING -- default to forward (0) in
        ; that case, matching "reading always reflects however the
        ; buffer was last actually written", not a fresh random choice
        ; with nothing to apply it to.
        move y:(r6+$16),a ; CAPTURE_ENABLED
        tst a
        bne <RVRS_DRAW_GATE
        clr a
        move a1,y:(r6+$11) ; REVERSE_FLAG=0 (forward) -- capture disabled
        bra <RVRS_DONE
RVRS_DRAW_GATE:
        move y:(r6+$4),x0 ; RVRS param, raw bipolar_q23
        move x0,a
        cmp #>$800000,a
        beq <RVRS_ALWAYS
        cmp #>$7e0000,a ; bipolar_q23's own knob=127 raw value is
                        ; $7e0000 ((knob-64)<<17), NOT $7f0000 (that's
                        ; unipolar's different shortfall)
        bge <RVRS_NEVER

        move #>$7fffff,a
        sub x0,a ; a = 1-RVRS, full accumulator, up to 2.0 -- not yet
                 ; truncated, cannot overflow
        asr a ; a = (1-RVRS)/2, now safely in [0,1]
        move a1,y0 ; y0 = p_reverse, stashed across the LFSR mix below
        bra <RVRS_DRAW
RVRS_ALWAYS:
        move #>1,a
        move a1,y:(r6+$11)
        bra <RVRS_DONE
RVRS_NEVER:
        clr a
        move a1,y:(r6+$11)
        bra <RVRS_DONE
RVRS_DRAW:
        ; 24-bit Galois LFSR (taps x^24+x^23+x^22+x^17+1, $c20001 --
        ; MDS's own pluck.asm56k example's noise generator idiom).
        ; Unrolled by hand, NOT wrapped in a hardware "do" loop -- the
        ; latter measured ~4600 EXTRA cycles on this toolchain/emulator
        ; in NFX-BO's own round-12 work despite looking obviously
        ; correct (see that file's RVRS_DRAW comment for the full story).
        move y:(r6+$12),b ; RNG_STATE
        move #>$c20001,x1
        lsl b
        bcc <RVRS_MIX1_KEEP
        eor x1,b
RVRS_MIX1_KEEP:
        lsl b
        bcc <RVRS_MIX2_KEEP
        eor x1,b
RVRS_MIX2_KEEP:
        lsl b
        bcc <RVRS_MIX3_KEEP
        eor x1,b
RVRS_MIX3_KEEP:
        lsl b
        bcc <RVRS_MIX4_KEEP
        eor x1,b
RVRS_MIX4_KEEP:
        lsl b
        bcc <RVRS_MIX5_KEEP
        eor x1,b
RVRS_MIX5_KEEP:
        lsl b
        bcc <RVRS_MIX6_KEEP
        eor x1,b
RVRS_MIX6_KEEP:
        lsl b
        bcc <RVRS_MIX7_KEEP
        eor x1,b
RVRS_MIX7_KEEP:
        lsl b
        bcc <RVRS_MIX8_KEEP
        eor x1,b
RVRS_MIX8_KEEP:
        move b1,y:(r6+$12) ; store the advanced RNG_STATE
        move b1,a
        and #>$7fffff,a ; fold into a unipolar fraction in [0,~1)
        move a1,x0 ; x0 = rng_fraction
        move y0,a ; a = p_reverse (stashed above)
        cmp x0,a
        bgt <RVRS_FLAG_SET
        clr a
        move a1,y:(r6+$11)
        bra <RVRS_DONE
RVRS_FLAG_SET:
        move #>1,a
        move a1,y:(r6+$11)
RVRS_DONE:

        ; --- STRT/LOOP -> LOOP_START/LOOP_LEN/LOOP_END (plain LOGICAL
        ; units now, not Q8 fixed-point -- see the Y+24/Y+25 header
        ; comments for why: SPED, round 3's variable-speed/reverse
        ; playback knob, was REMOVED 2026-11-04 (direct user request,
        ; after a real hardware report, "the speed parameter just makes
        ; it sound like hell" -- the root cause, a genuine calibration
        ; bug, was found and fixed first, but the user asked to pull the
        ; knob out entirely rather than ship-and-retest: "we might
        ; revisit"). LOOP_START/LOOP_END (the loop REGION's own bounds)
        ; stay plain integers regardless -- SPED round 2's own
        ; fixed-point accumulator (PB_FRAC) only tracks PLAYBACK's own
        ; sub-position WITHIN that region, never the region's bounds
        ; themselves. A single mpy against
        ; LOGICAL_BUFLEN does the *LOGICAL_BUFLEN conversion directly
        ; (same "fraction * plain integer lands correctly in a1, no
        ; shift needed" mpy semantics GATE's own analogous derivation
        ; already relies on). STRT/LOOP moved down to Y+6/Y+7 (were
        ; Y+7/Y+8) when SPED's slot was removed -- Y+8 is now the
        ; trailing unused slot, same convention as NFX-BO's own freed
        ; ALFC slot.
        move y:(r6+$6),y0 ; STRT, raw unipolar_q23
        move #>LOGICAL_BUFLEN,x0
        mpy y0,x0,a
        move a1,y:(r6+$1b) ; LOOP_START

        ; --- SPED: derive this trig's CONTINUOUS PLAYBACK rate (round
        ; 2, 2026-11-07 -- see the Y+8 header comment above for the
        ; full reasoning, and why a genuinely continuous rate stays
        ; just as simple as round 1's discrete one once direction is
        ; off the table). STEP_SIZE_Q8 = 64 (baseline) +/- a knob-
        ; proportional delta, same GROW/SHRINK branch-split idiom
        ; NFX-BO's own BEND knob already uses for an analogous bipolar
        ; "scale a baseline up one way, down the other" derivation.
        move y:(r6+$8),x0 ; SPED, raw bipolar_q23
        move x0,a
        tst a
        bge <SPED_FAST
        ; SLOW: STEP_SIZE = 64 - |raw|*48 (range down to 16 at raw=-1.0,
        ; i.e. 4x slower). Same exact-extreme guard as GATE/BEND's own
        ; $800000 case ("neg a" doesn't correctly negate a value loaded
        ; via "move y:addr,a" on this hardware -- see those params' own
        ; comments in NFXBO.asm56k for the full derivation).
        cmp #>$800000,a
        beq <SPED_NEG_MIN ; exact extreme -- skip the mpy entirely
                          ; (|raw| can only ever reach $7fffff, not a
                          ; true 1.0, so going through the mpy here
                          ; would truncate 0.99999988*48 down to 47,
                          ; landing STEP_SIZE one unit short of the
                          ; true minimum -- confirmed via direct probe
                          ; before trusting the special-case, see
                          ; DESIGN.md Sec 17)
        clr a
        sub x0,a ; a = |raw|
        move a1,x0 ; x0 = |raw|
        move #>48,y0
        mpy x0,y0,a ; a = |raw|*48 -- true fraction * plain int, lands
                    ; correctly in a1
        move a1,x0 ; x0 = delta
        move #>64,a
        sub x0,a ; a = 64-delta = STEP_SIZE
        bra <SPED_STEP_CLAMP
SPED_NEG_MIN:
        move #>16,a ; STEP_SIZE = 64-48 = 16, exact
        bra <SPED_STEP_CLAMP
SPED_FAST:
        ; FAST: STEP_SIZE = 64 + raw*191 (range up to ~252 at raw~1.0,
        ; i.e. just under 4x faster). x0 still holds the ORIGINAL raw
        ; (already >=0 here, no magnitude extraction needed).
        move #>191,y0
        mpy x0,y0,a ; a = raw*191
        move a1,x0 ; x0 = delta
        move #>64,a
        add x0,a ; a = 64+delta = STEP_SIZE
SPED_STEP_CLAMP:
        ; defensive clamp, cheap (once per trig) -- explicitly guards
        ; the Q8 "1.0 position/sample" boundary (255, not 256 -- see
        ; the Y+8 header comment for why never exactly 256) rather than
        ; trusting the scale factors above never to round past it.
        move #>255,x0
        cmp x0,a
        ble <SPED_STEP_OK
        move x0,a
SPED_STEP_OK:
        move a1,y:(r6+$1a) ; STEP_SIZE_Q8
        move a1,x0 ; x0 = STEP_SIZE_Q8 (plain small int, kept for the
                   ; shift just below)
        asl #15,a,a ; RAMP_FRACTION = STEP_SIZE_Q8<<15 -- a SINGLE,
                    ; FIXED-immediate shift (the shift amount, 15, is a
                    ; true compile-time constant; only the VALUE being
                    ; shifted varies per trig, so this carries none of
                    ; the register-sourced-shift verification burden
                    ; round 1's own design needed). Verified directly
                    ; via probe (decay_ramp_fraction_test.asm56k) that
                    ; this lands on EXACTLY $200000 (0.25, matching
                    ; 1/DECIM) at the baseline STEP_SIZE_Q8=64 before
                    ; trusting it across the continuous range -- see
                    ; DESIGN.md Sec 17.
        move a1,y:(r6+$1e) ; RAMP_FRACTION

        ; LOOP's raw fraction is SQUARED before scaling by
        ; LOGICAL_BUFLEN (2026-11-04, direct user request: "values
        ; close to zero have a higher resolution... logarithmic or
        ; square curve"). Same confirmed-correct "mpy of two TRUE Q23
        ; fractions lands in a1 directly" semantics already relied on
        ; throughout this file; same squaring idiom NFX-BO's own BEND
        ; shrink-branch already uses for an analogous reason (NFX-EN's
        ; own real firmware code does this too, per
        ; refs/GOLD_STANDARD.md). Squaring a fraction in [0,1) is always
        ; safe (result stays in [0,1), no overflow risk, no clamp
        ; needed for the squaring step itself) -- only the floor-clamp
        ; below (unrelated to this) is still needed.
        ;
        ; Effect: knob positions near 0 move LOOP_LEN only a LITTLE per
        ; step (d(x^2)/dx = 2x is small near x=0) -- fine resolution in
        ; the short-loop region where small absolute length changes
        ; have the biggest perceptual (pitch-like) effect. Positions
        ; near max move LOOP_LEN a LOT per step -- coarser there, where
        ; it matters less. This deliberately changes the exact linear
        ; "knob=64 -> half-length" reference point from this feature's
        ; original design conversation (now knob=64 -> ~1/4-length, since
        ; (64/127)^2 =~ 0.25) -- a known, intended consequence of moving
        ; to this curve, not an oversight.
        move y:(r6+$7),y0 ; LOOP_LEN, raw unipolar_q23
        move y0,x0
        mpy y0,x0,a ; a = LOOP_raw^2 (true fraction squared)
        move a1,y0 ; y0 = squared fraction
        move #>LOGICAL_BUFLEN,x0
        mpy y0,x0,a ; a = squared_fraction * LOGICAL_BUFLEN
        cmp #>LOOP_LEN_MIN,a
        bge <LOOPLEN_FLOOR_OK
        move #>LOOP_LEN_MIN,a
LOOPLEN_FLOOR_OK:
        move a1,y:(r6+$1c) ; LOOP_LEN (kept for reference/debugging only
                        ; -- PLAYBACK itself reads LOOP_END instead)

        ; LOOP_END = LOOP_START + LOOP_LEN, latched ONCE per trig (not
        ; recomputed every sample -- same reasoning as capture's own
        ; GATE-derived bounds). a1 still holds the just-stored (floored)
        ; LOOP_LEN -- the move above doesn't clobber the accumulator,
        ; so reuse it directly rather than re-reading Y-memory or
        ; relying on y0 (which still holds the ORIGINAL unfloored raw
        ; LOOP param, not this value).
        move y:(r6+$1b),x0 ; LOOP_START
        add x0,a ; a = START + (floored) LEN
        move a1,y:(r6+$1d) ; LOOP_END

        ; --- PB_POS starts at the loop region's own beginning;
        ; PB_FRAC seeded at exactly 0 (a fresh pass starts perfectly
        ; on-phase -- see the Y+31 header comment for why this needs
        ; no "advance immediately" engineering the way round 1's
        ; countdown convention did). ---
        clr a
        move a1,y:(r6+$1f) ; PB_FRAC=0
        move y:(r6+$1b),a ; LOOP_START
        move a1,y:(r6+$18) ; PB_POS

        ; --- GATE: shapes how many logical samples writing is allowed
        ; for, in LOGICAL units (LOGICAL_BUFLEN, not BUFLEN) -- same
        ; derivation as NFX-BO's own GATE, just on the doubled count.
        ; Reading/output is NEVER gated by this, only writing is.
        move y:(r6+$2),x0
        move x0,a
        tst a
        bge <GATE_POS
        cmp #>$800000,a
        beq <GATE_NEG_MIN
        clr a
        sub x0,a
        bra <GATE_NEG_OK
GATE_NEG_MIN:
        move #>$7fffff,a
GATE_NEG_OK:
        move a1,y0 ; y0 = |GATE|
        move #>LOGICAL_BUFLEN,x0
        mpy y0,x0,a ; true fraction * plain integer: a1 lands correctly
        move a1,x0 ; x0 = missing logical samples
        move #>LOGICAL_BUFLEN,a
        sub x0,a ; a = CAP_REMAIN = LOGICAL_BUFLEN - missing
        move a1,y:(r6+$d)
        clr a
        move a,y:(r6+$f) ; GATE<0: stop early, no start delay
        bra <GATE_DONE
GATE_POS:
        move a1,y0 ; y0 = GATE (already >=0)
        move #>LOGICAL_BUFLEN,x0
        mpy y0,x0,a
        move a1,x1 ; x1 = missing logical samples
        move #>LOGICAL_BUFLEN,a
        sub x1,a
        move a1,y:(r6+$d)
        move x1,y1 ; y1 = missing logical samples (mpy needs x0/x1/y0/y1)
        move #>DECIM,x0
        mpy y1,x0,a ; plain int * plain int -- small, needs the
                    ; doubled-product undo
        asr a
        move a0,a
        move a1,y:(r6+$f) ; CAP_DELAY_REMAIN, in REAL samples
GATE_DONE:

        ; --- position start point: 0 counting up (forward) or
        ; LOGICAL_BUFLEN-1 counting down (reverse). One counter drives
        ; BOTH read and write for the whole pass.
        move y:(r6+$11),a ; REVERSE_FLAG
        tst a
        bne <POS_REV
        clr a
        move a,y:(r6+$c) ; forward: LOGICAL_POS=0
        bra <POS_DONE
POS_REV:
        move #>LOGICAL_BUFLEN,a
        sub #>1,a
        move a1,y:(r6+$c) ; reverse: LOGICAL_POS=LOGICAL_BUFLEN-1
POS_DONE:
        move #>WINDOW_SAMPLES_Q6,x0
        move x0,y:(r6+$10) ; WINDOW_REMAIN, Q6-scaled -- see its own
                           ; header comment for why
        ; (no DECIM_CTR seed needed any more -- see RENDER_LOOP)
        clr a
        move a,y:(r6+$13) ; PENDING_HALF=0 (irrelevant until first used)
        move a,y:(r6+$14) ; HELD_WET=0 -- fresh pass starts silent, no
                          ; stale amplitude from before (same reasoning
                          ; as NFX-BO's own HELD_WET reset)
        move a,y:(r6+$15) ; INTERP_STEP=0
        move #>1,a
        move a,y:(r6+$a) ; PHASE=ACTIVE
RENDER_NOTRIG:

        ; --- once per block: neighbour buffers for NBAL (identical to
        ; NFX-BO's own setup) ---
        move y:>$7f0,r5
        move #>$ffffff,m5
        move y:(r5+2),r2 ; two back
        move y:(r5+1),r5 ; one back
        move #>$ffffff,m2

        move y:(r6+$9),r3 ; r3 = this track's buffer base
        move #>$ffffff,m3

        ; --- once per block: cache NBAL/MIX derived values (same
        ; hoist-out-of-the-hot-loop principle as NFX-BO) ---
        move #>$7fffff,a
        move y:(r6+$1),y0 ; NBAL
        sub y0,a
        move a1,n0 ; n0 = cached 1-NBAL
        move y:(r6+$1),n1 ; n1 = cached NBAL

        move y:(r6+$5),a ; MIX
        cmp #>$7f0000,a
        bge <PRE_MIX_FULL_WET
        move #>$7fffff,a
        move y:(r6+$5),x0
        sub x0,a
        move a1,r1 ; r1 = cached 1-MIX
        bra <PRE_MIX_DONE
PRE_MIX_FULL_WET:
        clr a
        move a1,r1
PRE_MIX_DONE:
        move y:(r6+$5),r4 ; r4 = cached MIX

        ; --- cache PLAYBACK's own per-trig constants into otherwise-
        ; unused registers (n4/n5), same hoist-out-of-the-hot-loop
        ; principle as NBAL/MIX above -- these run EVERY sample now
        ; (not gated by DECIM_CTR like capture itself is, though
        ; PLAYBACK's own POSITION only advances on its own accumulated
        ; schedule, see PB_FRAC below), so re-reading them from
        ; Y-memory 32 times/block instead of once was measured as a
        ; real, substantial cycle cost. ---
        move y:(r6+$1b),n4 ; n4 = cached LOOP_START
        move y:(r6+$1d),n5 ; n5 = cached LOOP_END

        ; --- SPED's own per-trig constants (round 2, continuous rate),
        ; same hoist principle. RAMP_FRACTION is read by the per-sample
        ; PLAYBACK block's own INTERP_STEP mpy at every one of the 4
        ; inner RENDER_LOOP positions now (not just an infrequent
        ; retarget site, unlike NUW-JT's own pre-SPED-revival build),
        ; so caching it is worth real cycles, same reasoning as LOOP_
        ; START/LOOP_END above. n2 confirmed free (used only as scratch
        ; within INIT's own TRACKMEM setup, long done by RENDER time).
        ; r0 confirmed free throughout this whole file otherwise. ---
        move y:(r6+$1e),n2 ; n2 = cached RAMP_FRACTION
        move y:(r6+$1a),r0 ; r0 = cached STEP_SIZE_Q8

        ; --- PB_POS and PB_FRAC are STATE, not constants -- they
        ; change every real sample -- but only need to PERSIST
        ; ACROSS BLOCKS, not be re-fetched WITHIN one. n6/n7 confirmed
        ; completely unused elsewhere in this file. Written back once
        ; after RENDER_END below. (Unlike the current bulk-pass NUW-JT
        ; build this was forked from, n7 is back in active use here --
        ; SPED's continuous rate means a crossing can land on any of
        ; the 4 inner positions, not just a fixed one, so every
        ; position must independently check its own live accumulator
        ; -- see RENDER_LOOP's own header comment.) ---
        move y:(r6+$18),n6 ; n6 = cached PB_POS
        move y:(r6+$1f),n7 ; n7 = cached PB_FRAC (Y+31, NEW slot -- the
                           ; SPED-revival workset grew by exactly 1
                           ; word to fit this; see NUWTS.json's
                           ; y_workset_words and the Y+31 header
                           ; comment above)
; ============================================================================
; RENDER_LOOP -- adapted 2026-11-06 from NUW-JT's own bulk-pass "do #8"
; grouping for SPED's revival. STILL a do#8/4-samples-per-iteration loop
; (CAPTURE's own cadence is UNCHANGED, still a fixed DECIM=4 stride, still
; always the group-local 4th position -- the original bulk-pass rewrite's
; own reasoning for THAT part carries over verbatim, see
; NUWJT_pre_bulkpass_backup.asm56k's own RENDER_LOOP header if you want the
; full original proof) -- but PLAYBACK no longer shares that fixed stride.
;
; With SPED's rate independent of DECIM, the OLD proof ("two counters with
; identical seed and identical period can never drift apart") no longer
; holds for PLAYBACK specifically -- PB_FRAC's own accumulation rate is
; now a per-trig, knob-derived, CONTINUOUS value (STEP_SIZE_Q8, see the
; SPED header comment), so a crossing can land on ANY of the 4 group-
; local positions, not just the one CAPTURE happens to use. So EVERY one
; of the 4 inner positions below independently checks its OWN PB_FRAC
; (cached in n7) and does the full playback-retarget-and-ramp when it
; overflows past 256 -- unlike the plain "ramp with whatever INTERP_STEP
; is already set" shortcut the 3 "plain" positions used before SPED
; existed. Only CAPTURE's own work (read/blend/write/advance LOGICAL_POS)
; stays confined to position 3. STEP_SIZE_Q8 is explicitly capped at 255
; (see the SPED header comment) so AT MOST ONE crossing can ever happen
; per real sample -- the check below is a single compare+branch, never a
; loop, regardless of how fast SPED is set.
;
; Still deliberately NOT nested hardware do-loops (the same Jcc-inside-
; do-loop lockup-bug caution as before) -- just more duplicated code, 4x
; per iteration, now with the PLAYBACK block duplicated at all 4 positions
; instead of being folded into position 3's own capture work.
;
; Every per-event detail below (window-boundary "blt" fix, reverse write-
; pairing, PB_ADDR_OK physical-wrap fix, shift-fusion-safe unpack
; patterns, FEEDBACK_GATE clamp, PHASE-idle skip-the-ramp behavior) is
; copied verbatim from the current NUW-JT build this was forked from --
; the ONLY new logic is PLAYBACK's own continuous-rate accumulator
; (replacing the old "always retarget on position 3, always just ramp
; elsewhere" shortcut) and its own INTERP_STEP derivation, which reuses
; NUW-JT's own original mpy-based halve-then-double pattern exactly
; (same reasoning: the full target-minus-HELD_WET diff can reach +/-2.0,
; past what mpy's Q23 operand range allows directly), just multiplying
; against a per-trig knob-derived RAMP_FRACTION instead of the fixed
; RAMP_FRACTION_FIXED constant.
; ============================================================================
RENDER_LOOP:
        do #8,RENDER_END
        ; ================= SAMPLE (group-local position 0) =================
        move y:(r2)+,x0 ; x0 = two_back
        move y:(r5)+,y1 ; y1 = one_back
        move n0,y0
        mpy x0,y0,a
        move n1,x0
        macr y1,x0,a
        move a1,x1 ; x1 = dry sample, live until this sample's own output mix

        clr b ; default silent wet output

        move y:(r6+$a),a ; PHASE
        tst a
        beq <TAIL_G0

        move y:(r6+$10),a ; WINDOW_REMAIN
        move r0,x0 ; r0 = cached STEP_SIZE_Q8 -- drain rate now tracks
                   ; SPED, see WINDOW_REMAIN's own header comment
        sub x0,a
        move a1,y:(r6+$10)
        blt <ENDING_G0 ; MUST be "blt" not "ble" -- see RENDER_LOOP header

        ; --- PLAYBACK: continuous-rate fractional accumulator (SPED
        ; round 2). Every one of the 4 group-local positions runs this
        ; now -- see RENDER_LOOP's own header comment for why. ---
        move n7,a ; PB_FRAC
        move r0,x0 ; r0 = cached STEP_SIZE_Q8
        add x0,a ; a = PB_FRAC + STEP_SIZE_Q8
        move #>256,x0
        cmp x0,a
        blt <PB_NOADV_G0 ; still <256 -- no crossing this sample
        sub #>256,a ; wrap the fractional remainder
        move a1,n7
        move n6,a ; PB_POS
        add #>1,a
        move n5,x0 ; x0 = cached LOOP_END
        cmp x0,a
        blt <PB_WRAP_DONE_G0
        move n4,a ; wrap: PB_POS = LOOP_START
PB_WRAP_DONE_G0:
        move a1,n6
        cmp #>LOGICAL_BUFLEN,a ; physical (buffer-length) wrap
        blt <PB_ADDR_OK_G0
        sub #>LOGICAL_BUFLEN,a
PB_ADDR_OK_G0:
        move a1,x0 ; x0 = physical address
        asr #1,a,a ; word-index = physical address >> 1
        move a1,n3
        move x0,a
        and #>1,a ; sub_phase = PB_POS & 1
        bne <PB_READ_BOTTOM_G0
        move y:(r3+n3),b
        asr #12,b,b
        move b1,a
        asl #12,a,a
        bra <PB_READ_DONE_G0
PB_READ_BOTTOM_G0:
        move y:(r3+n3),b
        asl #12,b,b
        move b1,a
        asr #12,a,a
        move a1,b
        asl #12,b,b
        move b1,a
PB_READ_DONE_G0:
        move a1,y0 ; y0 = new target
        move y0,a
        move y:(r6+$14),x0 ; HELD_WET
        sub x0,a ; a = target-HELD_WET, full accumulator, up to +/-2.0
        asr a ; a = diff/2, safely within +/-1.0 (same halve-before-mpy
             ; pattern NUW-JT's own original build used)
        move a1,x0 ; x0 = diff/2
        move n2,y0 ; n2 = cached RAMP_FRACTION (Q23 true fraction)
        mpy x0,y0,a ; a = (diff/2)*RAMP_FRACTION
        asl a ; undo the halving
        move a1,y:(r6+$15) ; INTERP_STEP
        bra <PB_SAME_G0
PB_NOADV_G0:
        move a1,n7 ; no crossing -- just store the incremented PB_FRAC
PB_SAME_G0:
        move y:(r6+$15),x0 ; INTERP_STEP (possibly just updated above)
        move y:(r6+$14),a
        add x0,a
        move a1,y:(r6+$14)
        move a1,b
        bra <TAIL_G0
ENDING_G0:
        clr a
        move a,y:(r6+$a) ; PHASE=IDLE -- pass is over, stop abruptly
TAIL_G0:
        move r1,y0
        mpy x1,y0,a
        move r4,y0
        move b1,x0
        macr x0,y0,a
        move a,y:(r7)+

        ; ================= SAMPLE (group-local position 1) =================
        move y:(r2)+,x0
        move y:(r5)+,y1
        move n0,y0
        mpy x0,y0,a
        move n1,x0
        macr y1,x0,a
        move a1,x1

        clr b

        move y:(r6+$a),a
        tst a
        beq <TAIL_G1

        move y:(r6+$10),a
        move r0,x0 ; STEP_SIZE_Q8
        sub x0,a
        move a1,y:(r6+$10)
        blt <ENDING_G1

        move n7,a ; PB_FRAC
        move r0,x0
        add x0,a
        move #>256,x0
        cmp x0,a
        blt <PB_NOADV_G1
        sub #>256,a
        move a1,n7
        move n6,a
        add #>1,a
        move n5,x0
        cmp x0,a
        blt <PB_WRAP_DONE_G1
        move n4,a
PB_WRAP_DONE_G1:
        move a1,n6
        cmp #>LOGICAL_BUFLEN,a
        blt <PB_ADDR_OK_G1
        sub #>LOGICAL_BUFLEN,a
PB_ADDR_OK_G1:
        move a1,x0
        asr #1,a,a
        move a1,n3
        move x0,a
        and #>1,a
        bne <PB_READ_BOTTOM_G1
        move y:(r3+n3),b
        asr #12,b,b
        move b1,a
        asl #12,a,a
        bra <PB_READ_DONE_G1
PB_READ_BOTTOM_G1:
        move y:(r3+n3),b
        asl #12,b,b
        move b1,a
        asr #12,a,a
        move a1,b
        asl #12,b,b
        move b1,a
PB_READ_DONE_G1:
        move a1,y0
        move y0,a
        move y:(r6+$14),x0
        sub x0,a
        asr a
        move a1,x0
        move n2,y0
        mpy x0,y0,a
        asl a
        move a1,y:(r6+$15)
        bra <PB_SAME_G1
PB_NOADV_G1:
        move a1,n7
PB_SAME_G1:
        move y:(r6+$15),x0
        move y:(r6+$14),a
        add x0,a
        move a1,y:(r6+$14)
        move a1,b
        bra <TAIL_G1
ENDING_G1:
        clr a
        move a,y:(r6+$a)
TAIL_G1:
        move r1,y0
        mpy x1,y0,a
        move r4,y0
        move b1,x0
        macr x0,y0,a
        move a,y:(r7)+

        ; ================= SAMPLE (group-local position 2) =================
        move y:(r2)+,x0
        move y:(r5)+,y1
        move n0,y0
        mpy x0,y0,a
        move n1,x0
        macr y1,x0,a
        move a1,x1

        clr b

        move y:(r6+$a),a
        tst a
        beq <TAIL_G2

        move y:(r6+$10),a
        move r0,x0 ; STEP_SIZE_Q8
        sub x0,a
        move a1,y:(r6+$10)
        blt <ENDING_G2

        move n7,a ; PB_FRAC
        move r0,x0
        add x0,a
        move #>256,x0
        cmp x0,a
        blt <PB_NOADV_G2
        sub #>256,a
        move a1,n7
        move n6,a
        add #>1,a
        move n5,x0
        cmp x0,a
        blt <PB_WRAP_DONE_G2
        move n4,a
PB_WRAP_DONE_G2:
        move a1,n6
        cmp #>LOGICAL_BUFLEN,a
        blt <PB_ADDR_OK_G2
        sub #>LOGICAL_BUFLEN,a
PB_ADDR_OK_G2:
        move a1,x0
        asr #1,a,a
        move a1,n3
        move x0,a
        and #>1,a
        bne <PB_READ_BOTTOM_G2
        move y:(r3+n3),b
        asr #12,b,b
        move b1,a
        asl #12,a,a
        bra <PB_READ_DONE_G2
PB_READ_BOTTOM_G2:
        move y:(r3+n3),b
        asl #12,b,b
        move b1,a
        asr #12,a,a
        move a1,b
        asl #12,b,b
        move b1,a
PB_READ_DONE_G2:
        move a1,y0
        move y0,a
        move y:(r6+$14),x0
        sub x0,a
        asr a
        move a1,x0
        move n2,y0
        mpy x0,y0,a
        asl a
        move a1,y:(r6+$15)
        bra <PB_SAME_G2
PB_NOADV_G2:
        move a1,n7
PB_SAME_G2:
        move y:(r6+$15),x0
        move y:(r6+$14),a
        add x0,a
        move a1,y:(r6+$14)
        move a1,b
        bra <TAIL_G2
ENDING_G2:
        clr a
        move a,y:(r6+$a)
TAIL_G2:
        move r1,y0
        mpy x1,y0,a
        move r4,y0
        move b1,x0
        macr x0,y0,a
        move a,y:(r7)+

        ; ============ SAMPLE (group-local position 3) ============
        ; Always CAPTURE's own fixed-stride event (unaffected by SPED --
        ; see RENDER_LOOP header) PLUS PLAYBACK's own independent check.
        move y:(r2)+,x0
        move y:(r5)+,y1
        move n0,y0
        mpy x0,y0,a
        move n1,x0
        macr y1,x0,a
        move a1,x1

        clr b

        move y:(r6+$a),a
        tst a
        beq <TAIL_G3

        move y:(r6+$10),a
        move r0,x0 ; STEP_SIZE_Q8
        sub x0,a
        move a1,y:(r6+$10)
        blt <ENDING_G3

        ; --- full capture work: read/blend/write/advance LOGICAL_POS.
        ; Verbatim from the current NUW-JT build, unaffected by SPED. ---
        move y:(r6+$c),a
        asr #1,a,a ; word-index = logical_pos >> 1 (single shift, safe)
        move a1,n3

        move y:(r6+$c),a
        and #>1,a ; sub_phase = logical_pos & 1
        bne <READ_BOTTOM

        move y:(r3+n3),b
        asr #12,b,b
        move b1,a
        asl #12,a,a ; a1 = old_sample, Q23-ish, top half
        bra <READ_DONE
READ_BOTTOM:
        move y:(r3+n3),b
        asl #12,b,b
        move b1,a
        asr #12,a,a
        move a1,b
        asl #12,b,b
        move b1,a ; a1 = old_sample, Q23-ish, bottom half
READ_DONE:
        move a1,y1 ; y1 = old_sample, for the REC blend only

        move y:(r6+$16),a ; CAPTURE_ENABLED
        tst a
        beq <ADVANCE_POS_CAP

        move y:(r6+$f),a ; CAP_DELAY_REMAIN
        tst a
        ble <CAP_ACTIVE
        sub #>1,a
        move a1,y:(r6+$f)
        bra <ADVANCE_POS_CAP
CAP_ACTIVE:
        move y:(r6+$d),a ; CAP_REMAIN
        tst a
        ble <ADVANCE_POS_CAP
        sub #>1,a
        move a1,y:(r6+$d)

        move y:(r6+$17),y0 ; REC_SCALE
        mpy y1,y0,a ; true fraction * true fraction
        move a1,x0 ; x0 = REC_SCALE*old_sample

        cmp #>FEEDBACK_GATE,a
        bge <FBGATE_KEEP
        cmp #>FEEDBACK_GATE_NEG,a
        ble <FBGATE_KEEP
        clr a
        move a1,x0
FBGATE_KEEP:

        move #>CAPTURE_DRY_HEADROOM,y0 ; y0 free here -- REC_SCALE (also
                                       ; y0) was already consumed above
        mpy x1,y0,a ; a = dry*headroom -- true fraction*true fraction,
                    ; lands correctly in a1; x1 itself is untouched, so
                    ; the later TAIL_Gx output mix still sees full-level
                    ; dry (this headroom is capture-write-only)
        add x0,a ; a = headroom-scaled dry + (gated) scaled old content
        cmp #>$7fffff,a
        ble <BLEND_CLAMP_LO
        move #>$7fffff,a
BLEND_CLAMP_LO:
        cmp #>$800000,a
        bge <BLEND_CLAMPED
        move #>$800000,a
BLEND_CLAMPED:
        asr #12,a,a ; quantize to signed 12-bit
        move a1,y1 ; y1 = quantized half (old_sample no longer needed)

        move y:(r6+$c),a
        and #>1,a ; sub_phase (0 or 1)
        move a1,x0 ; x0 = sub_phase (0 or 1)
        bne <WPAIR_BOTTOM

        move y1,a
        and #>$fff,a
        asl #12,a,a
        move a1,y1 ; y1 = this event's value, positioned
        bra <WPAIR_POS_DONE
WPAIR_BOTTOM:
        move y1,a
        and #>$fff,a
        move a1,y1 ; y1 = this event's value, positioned
WPAIR_POS_DONE:

        move y:(r6+$11),a ; REVERSE_FLAG
        cmp x0,a
        beq <FIRST_OF_PAIR

        move y:(r6+$13),a ; PENDING_HALF (already positioned)
        add y1,a
        move a1,y:(r3+n3)
        bra <ADVANCE_POS_CAP
FIRST_OF_PAIR:
        move y1,a
        move a1,y:(r6+$13) ; PENDING_HALF

ADVANCE_POS_CAP:
        ; --- wrap LOGICAL_POS modulo LOGICAL_BUFLEN both directions
        ; (2026-11-09, round 3): this was a plain unwrapped +-1 before --
        ; safe ONLY while the whole pass's duration was a WINDOW_SAMPLES
        ; flat-sample-count constant, which guaranteed LOGICAL_POS could
        ; never travel more than exactly one buffer-length over the
        ; pass's own lifetime. Now that WINDOW_REMAIN drains by
        ; STEP_SIZE_Q8 (see its own header comment), a slow SPED can
        ; make the pass run several buffer-lengths long, which drove
        ; LOGICAL_POS straight past the buffer with no bound -- caught
        ; by mds-certifier's exhaustive fuzz run as a genuine
        ; out-of-memory read ("reads outside its memory or imports,
        ; from Y:$11ffff"), not by any manual test. Same wrap idiom
        ; PB_POS's own physical-wrap check (PB_ADDR_OK_Gx) and JITR's
        ; own wrap (JITR_LOW_CHECK) already use elsewhere in this file.
        move y:(r6+$11),a ; REVERSE_FLAG
        tst a
        bne <POS_STEP_REV
        move y:(r6+$c),a
        add #>1,a
        cmp #>LOGICAL_BUFLEN,a
        blt <POS_STEP_DONE
        sub #>LOGICAL_BUFLEN,a
        bra <POS_STEP_DONE
POS_STEP_REV:
        move y:(r6+$c),a
        sub #>1,a
        tst a
        bge <POS_STEP_DONE
        add #>LOGICAL_BUFLEN,a
POS_STEP_DONE:
        move a1,y:(r6+$c)

        ; --- PLAYBACK: same continuous-rate accumulator check as the
        ; other 3 positions above, independent of the capture work
        ; just above. ---
        move n7,a ; PB_FRAC
        move r0,x0
        add x0,a
        move #>256,x0
        cmp x0,a
        blt <PB_NOADV_G3
        sub #>256,a
        move a1,n7
        move n6,a
        add #>1,a
        move n5,x0
        cmp x0,a
        blt <PB_WRAP_DONE_G3
        move n4,a
PB_WRAP_DONE_G3:
        move a1,n6
        cmp #>LOGICAL_BUFLEN,a
        blt <PB_ADDR_OK_G3
        sub #>LOGICAL_BUFLEN,a
PB_ADDR_OK_G3:
        move a1,x0
        asr #1,a,a
        move a1,n3
        move x0,a
        and #>1,a
        bne <PB_READ_BOTTOM_G3
        move y:(r3+n3),b
        asr #12,b,b
        move b1,a
        asl #12,a,a
        bra <PB_READ_DONE_G3
PB_READ_BOTTOM_G3:
        move y:(r3+n3),b
        asl #12,b,b
        move b1,a
        asr #12,a,a
        move a1,b
        asl #12,b,b
        move b1,a
PB_READ_DONE_G3:
        move a1,y0
        move y0,a
        move y:(r6+$14),x0
        sub x0,a
        asr a
        move a1,x0
        move n2,y0
        mpy x0,y0,a
        asl a
        move a1,y:(r6+$15)
        bra <PB_SAME_G3
PB_NOADV_G3:
        move a1,n7
PB_SAME_G3:
        move y:(r6+$15),x0
        move y:(r6+$14),a
        add x0,a
        move a1,y:(r6+$14)
        move a1,b
        bra <TAIL_G3
ENDING_G3:
        clr a
        move a,y:(r6+$a)
TAIL_G3:
        move r1,y0
        mpy x1,y0,a
        move r4,y0
        move b1,x0
        macr x0,y0,a
        move a,y:(r7)+
RENDER_END:
        ; persist n6/n7 (PB_POS/PB_FRAC) back to Y-memory once per
        ; block.
        move n6,y:(r6+$18) ; PB_POS
        move n7,y:(r6+$1f) ; PB_FRAC
        rts
